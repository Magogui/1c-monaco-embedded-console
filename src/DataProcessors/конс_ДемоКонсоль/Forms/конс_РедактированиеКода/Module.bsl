КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура конс_НачальноеЗаполнение()

	конс_КомандыРедактораКлиент.УстановитьТекст(ЭтотОбъект, Объект.конс_Код, Неопределено, Ложь);

КонецПроцедуры

// Строит колонки таблицы результата запроса по составу колонок ТаблицыЗначений
// и загружает данные из временного хранилища
&НаСервере
Процедура ЗагрузитьРезультатЗапросаНаСервере(АдресРезультата)

	Таблица = ПолучитьИзВременногоХранилища(АдресРезультата);

	Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;

	// Пересоздаем колонки-реквизиты под состав текущего результата.
	// Удаление и добавление разделены, чтобы одноименные колонки не конфликтовали.
	УдаляемыеРеквизиты = Новый Массив;
	Для Каждого Реквизит Из ПолучитьРеквизиты("конс_РезультатЗапроса") Цикл
		УдаляемыеРеквизиты.Добавить("конс_РезультатЗапроса." + Реквизит.Имя);
	КонецЦикла;

	Если УдаляемыеРеквизиты.Количество() > 0 Тогда
		ИзменитьРеквизиты(, УдаляемыеРеквизиты);
	КонецЕсли;

	ДобавляемыеРеквизиты = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ДобавляемыеРеквизиты.Добавить(
			Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "конс_РезультатЗапроса", Колонка.Заголовок));
	КонецЦикла;

	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	ЭлементТаблицы = Элементы.конс_РезультатЗапроса;

	Пока ЭлементТаблицы.ПодчиненныеЭлементы.Количество() > 0 Цикл
		Элементы.Удалить(ЭлементТаблицы.ПодчиненныеЭлементы[0]);
	КонецЦикла;

	Для Каждого Колонка Из Таблица.Колонки Цикл
		ЭлементКолонки = Элементы.Добавить("конс_РезультатЗапроса" + Колонка.Имя, Тип("ПолеФормы"), ЭлементТаблицы);
		ЭлементКолонки.Вид = ВидПоляФормы.ПолеВвода;
		ЭлементКолонки.ПутьКДанным = "конс_РезультатЗапроса." + Колонка.Имя;
		ЭлементКолонки.ТолькоПросмотр = Истина;
	КонецЦикла;

	ЗначениеВРеквизитФормы(Таблица, "конс_РезультатЗапроса");

	ЭлементТаблицы.Видимость = Истина;

КонецПроцедуры

#КонецОбласти

