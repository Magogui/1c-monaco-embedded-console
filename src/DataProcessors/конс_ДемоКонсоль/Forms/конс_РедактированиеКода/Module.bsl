
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	конс_ИнициализацияРедактораСервер.ПриСозданииНаСервере(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Асинх Процедура ПриОткрытии(Отказ)

	Ждать конс_ИнициализацияРедактораКлиент.ПриОткрытии(ЭтотОбъект);
	
	УстановитьВидимостьДоступность();

КонецПроцедуры

&НаКлиенте
Асинх Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Ждать конс_ИнициализацияРедактораКлиент.ПередЗакрытием(ЭтотОбъект, Отказ, ЗавершениеРаботы, ТекстПредупреждения,
		СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)

	Объект.конс_Код = конс_КомандыРедактораКлиент.ПолучитьТекст(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "конс_ВыполненЗапрос" И Источник = ЭтотОбъект Тогда
		ЗагрузитьРезультатЗапросаНаСервере(Параметр.АдресРезультата);
	ИначеЕсли ИмяСобытия = "конс_РедакторГотов" И Источник = ЭтотОбъект Тогда
		конс_НачальноеЗаполнение();
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура конс_ПодключаемыйДокументСформирован(Элемент)

	Если ЭтотОбъект.конс_ИсходникиЗагружены Тогда
		ПодключитьОбработчикОжидания("конс_ИнициализироватьДокумент", 0.2, Истина);
	Иначе
		конс_ИнициализацияРедактораКлиент.ЗапланироватьПовторнуюИнициализацию(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура конс_ПовторИнициализацииКонсоли()

	конс_ИнициализацияРедактораКлиент.ПовторИнициализацииКонсоли(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура конс_ПодключаемыйПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	конс_КомандыРедактораКлиент.ОбработатьСобытиеСУчетомРежимаЧтения(ЭтотОбъект, ДанныеСобытия.Event.eventData1C);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура конс_КонструкторЗапроса(Команда)

	конс_КомандыРедактораКлиент.ВызватьКонструкторЗапроса(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура конс_ТолькоДляЧтения(Команда)

	конс_КомандыРедактораКлиент.ТолькоДляЧтения(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура конс_БыстрыеПодсказки(Команда)

	конс_КомандыРедактораКлиент.БыстрыеПодсказки(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура конс_ПодсвечиватьЗапросы(Команда)

	конс_КомандыРедактораКлиент.ПодсвечиватьЗапросы(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура конс_СтрокаСостояния(Команда)

	конс_КомандыРедактораКлиент.СтрокаСостояния(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура конс_СовременныеВозможности(Команда)

	Элементы.конс_СовременныеВозможности.Пометка = Не Элементы.конс_СовременныеВозможности.Пометка;
	конс_КомандыРедактораКлиент.СовременныеВозможностиMonaco(ЭтотОбъект, Элементы.конс_СовременныеВозможности.Пометка, Истина);

КонецПроцедуры

&НаКлиенте
Процедура конс_СохранитьИЗакрыть(Команда)

	Текст = конс_КомандыРедактораКлиент.ПолучитьТекст(ЭтотОбъект);
	Закрыть(Текст);

КонецПроцедуры

&НаКлиенте
Процедура конс_ВыполнитьКод(Команда)

	конс_КомандыРедактораКлиент.ВыполнитьКод(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура конс_ВыполнитьЗапрос(Команда)

	конс_КомандыРедактораКлиент.ВыполнитьЗапрос(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура конс_ПредыдущийКод(Команда)

	конс_КомандыРедактораКлиент.ПоказатьИсториюВыполнения(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьВидимостьДоступность()

	Элементы.конс_ТолькоДляЧтения.Пометка = Не ЭтотОбъект.конс_ТолькоДляЧтения;
	Элементы.конс_СтрокаСостояния.Пометка = ЭтотОбъект.конс_ВидимостьСтрокиСостояния;
	Элементы.конс_БыстрыеПодсказки.Пометка = ЭтотОбъект.конс_БыстрыеПодсказки;
	Элементы.конс_ПодсвечиватьЗапросы.Пометка = ЭтотОбъект.конс_ПодсвечиватьЗапросы;
	Элементы.конс_СовременныеВозможности.Пометка = Истина;

КонецПроцедуры

&НаКлиенте
Процедура конс_ИнициализироватьДокумент()
	конс_ИнициализацияРедактораКлиент.ДокументСформирован(Элементы.конс_Код, ЭтотОбъект);
	конс_НачальноеЗаполнение();
КонецПроцедуры

&НаКлиенте
Процедура конс_НачальноеЗаполнение()

	конс_ОбновитьСписокОбщихМодулей();
	
	конс_КомандыРедактораКлиент.УстановитьТекст(ЭтотОбъект, Объект.конс_Код, Неопределено, Ложь);
	конс_КомандыРедактораКлиент.СовременныеВозможностиMonaco(ЭтотОбъект, Истина);
	
	Доступность = ЭтотОбъект.конс_ДокументЗагружен;
	
КонецПроцедуры

// Строит колонки таблицы результата запроса по составу колонок ТаблицыЗначений
// и загружает данные из временного хранилища
&НаСервере
Процедура ЗагрузитьРезультатЗапросаНаСервере(АдресРезультата)

	Таблица = ПолучитьИзВременногоХранилища(АдресРезультата);

	Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;

	// Пересоздаем колонки-реквизиты под состав текущего результата.
	// Удаление и добавление разделены, чтобы одноименные колонки не конфликтовали.
	УдаляемыеРеквизиты = Новый Массив;
	Для Каждого Реквизит Из ПолучитьРеквизиты("конс_РезультатЗапроса") Цикл
		УдаляемыеРеквизиты.Добавить("конс_РезультатЗапроса." + Реквизит.Имя);
	КонецЦикла;

	Если УдаляемыеРеквизиты.Количество() > 0 Тогда
		ИзменитьРеквизиты(, УдаляемыеРеквизиты);
	КонецЕсли;

	ДобавляемыеРеквизиты = Новый Массив;
	Для Каждого Колонка Из Таблица.Колонки Цикл
		ДобавляемыеРеквизиты.Добавить(
			Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "конс_РезультатЗапроса", Колонка.Заголовок));
	КонецЦикла;

	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	ЭлементТаблицы = Элементы.конс_РезультатЗапроса;

	Пока ЭлементТаблицы.ПодчиненныеЭлементы.Количество() > 0 Цикл
		Элементы.Удалить(ЭлементТаблицы.ПодчиненныеЭлементы[0]);
	КонецЦикла;

	Для Каждого Колонка Из Таблица.Колонки Цикл
		ЭлементКолонки = Элементы.Добавить("конс_РезультатЗапроса" + Колонка.Имя, Тип("ПолеФормы"), ЭлементТаблицы);
		ЭлементКолонки.Вид = ВидПоляФормы.ПолеВвода;
		ЭлементКолонки.ПутьКДанным = "конс_РезультатЗапроса." + Колонка.Имя;
		ЭлементКолонки.ТолькоПросмотр = Истина;
	КонецЦикла;

	ЗначениеВРеквизитФормы(Таблица, "конс_РезультатЗапроса");

	ЭлементТаблицы.Видимость = Истина;

КонецПроцедуры

&НаКлиенте
Процедура конс_ОбновитьСписокОбщихМодулей()
	
	КоллекцияМетаданных = ПолучитьИзВременногоХранилища(ЭтотОбъект.конс_АдресОбщихМодулей);
	
	конс_КомандыРедактораКлиент.View(ЭтотОбъект).clearMetadata();
	Если КоллекцияМетаданных <> Неопределено Тогда
		Результат = конс_КомандыРедактораКлиент.View(ЭтотОбъект).updateMetadata(КоллекцияМетаданных, "commonModules.items");
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

