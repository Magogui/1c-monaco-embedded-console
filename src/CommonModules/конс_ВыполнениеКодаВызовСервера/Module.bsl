#Область ПрограммныйИнтерфейс

// Проверяет, доступно ли текущему пользователю выполнение произвольного кода.
//
// Возвращаемое значение:
//  Булево - Истина, если пользователю назначена роль конс_ВыполнениеКода
//           либо у него есть право администрирования
Функция ВыполнениеКодаДоступно() Экспорт

	Возврат РольДоступна("конс_ВыполнениеКода")
		Или ПравоДоступа("Администрирование", Метаданные);

КонецФункции

// Выполняет произвольный код 1С на сервере.
//
// Параметры:
//  ТекстКода - Строка - текст кода на встроенном языке
//
// Возвращаемое значение:
//  Структура:
//   * Успех          - Булево - признак успешного выполнения
//   * Сообщения      - Массив из Строка - сообщения, выведенные через Сообщить()
//   * ОписаниеОшибки - Строка - описание ошибки (если Успех = Ложь)
//   * СтрокаОшибки   - Число  - номер строки кода с ошибкой (0, если не определён)
//   * Длительность   - Число  - длительность выполнения в миллисекундах
Функция ВыполнитьКод(Знач ТекстКода) Экспорт

	ПроверитьПравоВыполнения();

	Результат = НовыйРезультатВыполнения();

	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка
		Выполнить(ТекстКода);
		Результат.Успех = Истина;
	Исключение
		Инфо = ИнформацияОбОшибке();
		Результат.Успех = Ложь;
		Результат.ОписаниеОшибки = КраткоеОписаниеОшибкиВыполнения(Инфо);
		Результат.СтрокаОшибки = СтрокаОшибкиИзИнформации(Инфо);
	КонецПопытки;

	Результат.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;

	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Результат.Сообщения.Добавить(Сообщение.Текст);
	КонецЦикла;

	ДобавитьВИсториюВыполнения(ТекстКода);

	Возврат Результат;

КонецФункции

// Выполняет запрос на сервере и помещает результат во временное хранилище.
//
// Параметры:
//  ТекстЗапроса        - Строка - текст запроса
//  Параметры           - Структура - параметры запроса (имя -> значение); может быть Неопределено
//  ИдентификаторФормы  - УникальныйИдентификатор - владелец временного хранилища
//
// Возвращаемое значение:
//  Структура:
//   * Успех           - Булево
//   * Сообщения       - Массив из Строка
//   * ОписаниеОшибки  - Строка
//   * СтрокаОшибки    - Число - номер строки текста запроса с ошибкой (0, если не определён)
//   * Длительность    - Число - миллисекунды
//   * АдресРезультата - Строка - адрес ТаблицыЗначений во временном хранилище
//   * КоличествоСтрок - Число  - число строк результата
//   * Колонки         - Массив из Строка - имена колонок результата
Функция ВыполнитьЗапрос(Знач ТекстЗапроса, Знач Параметры = Неопределено, Знач ИдентификаторФормы = Неопределено) Экспорт

	ПроверитьПравоВыполнения();

	Результат = НовыйРезультатВыполнения();
	Результат.Вставить("АдресРезультата", "");
	Результат.Вставить("КоличествоСтрок", 0);
	Результат.Вставить("Колонки", Новый Массив);

	Запрос = Новый Запрос(ТекстЗапроса);

	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		Для Каждого Параметр Из Параметры Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;

	НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();

	Попытка

		Таблица = Запрос.Выполнить().Выгрузить();

		Результат.Успех = Истина;
		Результат.КоличествоСтрок = Таблица.Количество();

		Для Каждого Колонка Из Таблица.Колонки Цикл
			Результат.Колонки.Добавить(Колонка.Имя);
		КонецЦикла;

		Результат.АдресРезультата = ПоместитьВоВременноеХранилище(Таблица, ИдентификаторФормы);

	Исключение
		Инфо = ИнформацияОбОшибке();
		Результат.Успех = Ложь;
		Результат.ОписаниеОшибки = КраткоеОписаниеОшибкиВыполнения(Инфо);
		Результат.СтрокаОшибки = СтрокаОшибкиИзИнформации(Инфо);
	КонецПопытки;

	Результат.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;

	Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
		Результат.Сообщения.Добавить(Сообщение.Текст);
	КонецЦикла;

	ДобавитьВИсториюВыполнения(ТекстЗапроса);

	Возврат Результат;

КонецФункции

// Возвращает историю выполнения кода: последние сниппеты, новые в начале.
//
// Возвращаемое значение:
//  Массив из Строка
Функция ИсторияВыполнения() Экспорт

	История = ХранилищеСистемныхНастроек.Загрузить("КонсольКода_Monaco", "ИсторияВыполнения");

	Если ТипЗнч(История) <> Тип("Массив") Тогда
		История = Новый Массив;
	КонецЕсли;

	Возврат История;

КонецФункции

// Возвращает описание ветки результата запроса для ленивого раскрытия в дереве значений.
// При ИндексСтроки = -1 возвращает уровень строк таблицы, иначе - колонки указанной строки.
//
// Параметры:
//  АдресРезультата   - Строка - адрес ТаблицыЗначений во временном хранилище
//  ИдентификаторУзла - Строка - id раскрываемого узла дерева
//  ИндексСтроки      - Число  - индекс строки таблицы или -1 для уровня строк
//
// Возвращаемое значение:
//  Соответствие - данные узла в формате tree.js (label/type/value/icon/path/children)
Функция ОписаниеВеткиРезультата(Знач АдресРезультата, Знач ИдентификаторУзла, Знач ИндексСтроки = -1) Экспорт

	ПроверитьПравоВыполнения();

	МаксимумСтрок = 300;

	Ветка = Новый Соответствие;

	Таблица = ПолучитьИзВременногоХранилища(АдресРезультата);

	Если ТипЗнч(Таблица) <> Тип("ТаблицаЗначений") Тогда
		Возврат Ветка;
	КонецЕсли;

	Узел = Новый Структура;
	Дети = Новый Соответствие;

	Если ИндексСтроки < 0 Тогда

		Узел.Вставить("label", "Результат запроса");
		Узел.Вставить("type", СтрШаблон("строк: %1", Формат(Таблица.Количество(), "ЧГ=0")));
		Узел.Вставить("icon", "table.png");

		КоличествоВывода = Мин(Таблица.Количество(), МаксимумСтрок);

		Для Индекс = 0 По КоличествоВывода - 1 Цикл
			УзелСтроки = Новый Структура;
			УзелСтроки.Вставить("label", "Строка " + Формат(Индекс + 1, "ЧГ=0"));
			УзелСтроки.Вставить("icon", "structure.png");
			УзелСтроки.Вставить("path", АдресРезультата + "|" + Формат(Индекс, "ЧГ=0"));
			Дети.Вставить("exec_row_" + Формат(Индекс, "ЧГ=0"), УзелСтроки);
		КонецЦикла;

		Если МаксимумСтрок < Таблица.Количество() Тогда
			УзелОстатка = Новый Структура;
			УзелОстатка.Вставить("label", СтрШаблон("... ещё строк: %1",
				Формат(Таблица.Количество() - МаксимумСтрок, "ЧГ=0")));
			УзелОстатка.Вставить("icon", "text.png");
			УзелОстатка.Вставить("class", "final");
			Дети.Вставить("exec_rows_more", УзелОстатка);
		КонецЕсли;

	ИначеЕсли ИндексСтроки < Таблица.Количество() Тогда

		СтрокаТаблицы = Таблица[ИндексСтроки];

		Узел.Вставить("label", "Строка " + Формат(ИндексСтроки + 1, "ЧГ=0"));
		Узел.Вставить("icon", "structure.png");

		НомерКолонки = 0;
		Для Каждого Колонка Из Таблица.Колонки Цикл
			Значение = СтрокаТаблицы[Колонка.Имя];
			УзелКолонки = Новый Структура;
			УзелКолонки.Вставить("label", Колонка.Имя);
			УзелКолонки.Вставить("value", Строка(Значение));
			УзелКолонки.Вставить("type", Строка(ТипЗнч(Значение)));
			УзелКолонки.Вставить("icon", ИконкаПоЗначению(Значение));
			УзелКолонки.Вставить("class", "final");
			Дети.Вставить(ИдентификаторУзла + "_col_" + Формат(НомерКолонки, "ЧГ=0"), УзелКолонки);
			НомерКолонки = НомерКолонки + 1;
		КонецЦикла;

	Иначе
		Возврат Ветка;
	КонецЕсли;

	Узел.Вставить("children", Дети);
	Ветка.Вставить(ИдентификаторУзла, Узел);

	Возврат Ветка;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьПравоВыполнения()

	Если Не ВыполнениеКодаДоступно() Тогда
		ВызватьИсключение "Недостаточно прав для выполнения кода. Требуется роль ""конс_ВыполнениеКода"".";
	КонецЕсли;

КонецПроцедуры

Функция НовыйРезультатВыполнения()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщения", Новый Массив);
	Результат.Вставить("ОписаниеОшибки", "");
	Результат.Вставить("СтрокаОшибки", 0);
	Результат.Вставить("Длительность", 0);

	Возврат Результат;

КонецФункции

Процедура ДобавитьВИсториюВыполнения(Знач Текст)

	МаксимумЭлементов = 20;

	Текст = СокрЛП(Текст);

	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;

	История = ИсторияВыполнения();

	Индекс = История.Найти(Текст);
	Если Индекс <> Неопределено Тогда
		История.Удалить(Индекс);
	КонецЕсли;

	История.Вставить(0, Текст);

	Пока История.Количество() > МаксимумЭлементов Цикл
		История.Удалить(МаксимумЭлементов);
	КонецЦикла;

	ХранилищеСистемныхНастроек.Сохранить("КонсольКода_Monaco", "ИсторияВыполнения", История);

КонецПроцедуры

Функция ИконкаПоЗначению(Значение)

	ТипЗначения = ТипЗнч(Значение);

	Если Значение = Неопределено Тогда
		Возврат "undefined.png";
	ИначеЕсли Значение = NULL Тогда
		Возврат "null.png";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат "int.png";
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат "string.png";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат "date.png";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат "boolean.png";
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат "uuid.png";
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат "array.png";
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Возврат "structure.png";
	ИначеЕсли ТипЗначения = Тип("ТаблицаЗначений") Тогда
		Возврат "table.png";
	КонецЕсли;

	Возврат "keyvalue.png";

КонецФункции

Функция КраткоеОписаниеОшибкиВыполнения(Инфо)

	// Для Выполнить() полезная информация находится в первопричине
	ПервоПричина = Инфо;
	Пока ПервоПричина.Причина <> Неопределено Цикл
		ПервоПричина = ПервоПричина.Причина;
	КонецЦикла;

	Возврат ПервоПричина.Описание;

КонецФункции

// Извлекает номер строки из позиции вида "{(3,5)}" или "{(3)}" в описании ошибки
Функция СтрокаОшибкиИзИнформации(Инфо)

	НомерСтроки = 0;

	ПервоПричина = Инфо;
	Пока ПервоПричина.Причина <> Неопределено Цикл
		ПервоПричина = ПервоПричина.Причина;
	КонецЦикла;

	Представление = ПодробноеПредставлениеОшибки(ПервоПричина);

	ПозицияНачала = СтрНайти(Представление, "{(");
	Если ПозицияНачала > 0 Тогда

		Фрагмент = Сред(Представление, ПозицияНачала + 2, 10);
		НомерТекст = "";

		Для НомерСимвола = 1 По СтрДлина(Фрагмент) Цикл
			Символ = Сред(Фрагмент, НомерСимвола, 1);
			Если Символ >= "0" И Символ <= "9" Тогда
				НомерТекст = НомерТекст + Символ;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЦикла;

		Если ЗначениеЗаполнено(НомерТекст) Тогда
			Попытка
				НомерСтроки = Число(НомерТекст);
			Исключение
				НомерСтроки = 0;
			КонецПопытки;
		КонецЕсли;

	КонецЕсли;

	Возврат НомерСтроки;

КонецФункции

#КонецОбласти
