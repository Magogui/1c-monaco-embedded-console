// Выполняет код из редактора на сервере и показывает результат в панели результатов.
// В режиме запроса (bsl_query) автоматически выполняет запрос.
// Выполняется выделенный фрагмент, а при его отсутствии - весь текст.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с редактором
//
// Возвращаемое значение:
//  Структура - результат выполнения (см. конс_ВыполнениеКодаВызовСервера.ВыполнитьКод);
//              для запроса дополнительно содержит АдресРезультата, КоличествоСтрок, Колонки
Функция ВыполнитьКод(Форма) Экспорт

	Если View(Форма).queryMode Тогда
		Возврат ВыполнитьЗапрос(Форма);
	КонецЕсли;

	Фрагмент = ТекстДляВыполнения(Форма);

	Если Не ЗначениеЗаполнено(СокрЛП(Фрагмент.Текст)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	СброситьМаркерыОшибок(Форма);
	View(Форма).showExecutionStatus("Выполняется код…");

	Результат = конс_ВыполнениеКодаВызовСервера.ВыполнитьКод(Фрагмент.Текст);

	View(Форма).hideExecutionStatus(ТекстДлительностиВыполнения(Результат));

	Если Результат.СтрокаОшибки > 0 Тогда
		Результат.СтрокаОшибки = Результат.СтрокаОшибки + Фрагмент.СмещениеСтрок;
	КонецЕсли;

	ПоказатьРезультатВыполнения(Форма, Результат, "Выполнение кода");

	Возврат Результат;

КонецФункции

// Выполняет текст из редактора как запрос на сервере.
// Результат (ТаблицаЗначений) помещается во временное хранилище, адрес - в поле АдресРезультата.
//
// Параметры:
//  Форма     - ФормаКлиентскогоПриложения - форма с редактором
//  Параметры - Структура - параметры запроса; может быть Неопределено
//
// Возвращаемое значение:
//  Структура - результат выполнения (см. конс_ВыполнениеКодаВызовСервера.ВыполнитьЗапрос)
Функция ВыполнитьЗапрос(Форма, Параметры = Неопределено) Экспорт

	Фрагмент = ТекстДляВыполнения(Форма);
	ТекстЗапроса = Фрагмент.Текст;

	Если Не ЗначениеЗаполнено(СокрЛП(ТекстЗапроса)) Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Код вида Запрос.Текст = "ВЫБРАТЬ ..." - убираем кавычки и разделители
	ПодготовитьТекстЗапросаККонструкторуЗапросов(ТекстЗапроса, Форма);

	СброситьМаркерыОшибок(Форма);
	View(Форма).showExecutionStatus("Выполняется запрос…");

	Результат = конс_ВыполнениеКодаВызовСервера.ВыполнитьЗапрос(ТекстЗапроса, Параметры,
		Форма.УникальныйИдентификатор);

	View(Форма).hideExecutionStatus(ТекстДлительностиВыполнения(Результат));

	Если Результат.СтрокаОшибки > 0 Тогда
		Результат.СтрокаОшибки = Результат.СтрокаОшибки + Фрагмент.СмещениеСтрок;
	КонецЕсли;

	ПоказатьРезультатВыполнения(Форма, Результат, "Выполнение запроса");

	Если Результат.Успех И ЗначениеЗаполнено(Результат.АдресРезультата) Тогда
		// Форма может показать таблицу результата (см. демо конс_ДемоКонсоль)
		Оповестить("конс_ВыполненЗапрос", Результат, Форма);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Признак доступности выполнения кода текущему пользователю
Функция ВыполнениеКодаДоступно() Экспорт

	Возврат конс_ВыполнениеКодаВызовСервера.ВыполнениеКодаДоступно();

КонецФункции

// Показывает список последних выполненных сниппетов и вставляет выбранный в редактор
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с редактором
Процедура ПоказатьИсториюВыполнения(Форма) Экспорт

	История = конс_ВыполнениеКодаВызовСервера.ИсторияВыполнения();

	Если История.Количество() = 0 Тогда
		ПоказатьОповещениеПользователя("Консоль кода", , "История выполнения пуста");
		Возврат;
	КонецЕсли;

	Список = Новый СписокЗначений;
	Для Каждого Сниппет Из История Цикл
		Представление = СтрЗаменить(СокрЛП(Сниппет), Символы.ПС, " ");
		Если СтрДлина(Представление) > 75 Тогда
			Представление = Лев(Представление, 75) + "...";
		КонецЕсли;
		Список.Добавить(Сниппет, Представление);
	КонецЦикла;

	ДопПараметры = Новый Структура("Форма", Форма);
	Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборИзИстории", ЭтотОбъект, ДопПараметры);

	Список.ПоказатьВыборЭлемента(Оповещение, "История выполнения");

КонецПроцедуры

Процедура ЗавершитьВыборИзИстории(ВыбранныйЭлемент, ДопПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ОбновитьТекст(ДопПараметры.Форма, ВыбранныйЭлемент.Значение, Ложь);

КонецПроцедуры

