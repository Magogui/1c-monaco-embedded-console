// Обрабатывает события редактора и выполняет соответствующие действия в зависимости от типа события
// 
// Параметры:
//  Форма  - ФормаКлиентскогоПриложения - форма редактора
//  Событие - Структура - Объект события редактора с информацией о событии
Процедура ОбработатьСобытиеРедактора(Форма, Событие) Экспорт

	Если Событие <> Неопределено Тогда
	
		ИмяСобытия = Событие.event;
	
		Если ИмяСобытия = "EVENT_QUERY_CONSTRUCT" Тогда
	
			ВызватьКонструкторЗапроса(Форма, Событие.params);
		КонецЕсли;
	
		Если ИмяСобытия = "EVENT_FORMAT_CONSTRUCT" Тогда
			ВызватьКонструкторФорматнойСтроки(Форма, Событие.params);
		КонецЕсли;
	
		Если ИмяСобытия = "EVENT_CONTENT_CHANGED" Тогда
			Форма.Модифицированность = Истина;
		КонецЕсли;
	
		Если ИмяСобытия = "EVENT_GET_METADATA" Тогда
			конс_ИнициализацияРедактораКлиент.ОбработкаСобытияПолученияМетаданных(Форма, Событие.params);
		КонецЕсли;
	
		Если ИмяСобытия = "EVENT_ON_LINK_CLICK" Тогда
			Если 0 < СтрНайти(Событие.params.href, "e1cib") Тогда
				ПерейтиПоНавигационнойСсылке(Событие.params.href);
			КонецЕсли;
		КонецЕсли;
	
		// Ctrl+Enter (2048 | 3 = 2051) - выполнить код
		Если ИмяСобытия = "EVENT_KEY_BINDING_2051" Тогда
			ВыполнитьКод(Форма);
		КонецЕсли;
	
		Если ИмяСобытия = "EVENT_GET_DEFINITION" Тогда
			конс_ИнициализацияРедактораКлиент.ОткрытьОпределение(Форма, Событие.params);
		КонецЕсли;
	
		Если ИмяСобытия = "EVENT_GET_VARIABLE_DATA" Тогда
			ОбработатьЗапросДанныхПеременной(Форма, Событие.params);
		КонецЕсли;
	
		Если ИмяСобытия = "EVENT_TYPE_CONSTRUCT" Тогда
			ВызватьКонструкторТипа(Форма, Ложь);
		КонецЕсли;
	
		Если ИмяСобытия = "EVENT_TYPEDESCRIPTION_CONSTRUCT" Тогда
			ВызватьКонструкторТипа(Форма, Истина);
		КонецЕсли;

		// Пользователь сменил тему через тулбар редактора - сохраняем выбор
		Если ИмяСобытия = "EVENT_THEME_CHANGED" Тогда
			СохранитьНастройкуРедактора("Тема", Событие.params.theme);
		КонецЕсли;

		// Monaco создал редактор — повторяем init, если 1С опередила загрузку скриптов
		Если ИмяСобытия = "EVENT_EDITOR_READY" Тогда
			конс_ИнициализацияРедактораКлиент.ПриГотовностиРедактора(Форма);
		КонецЕсли;
	
	КонецЕсли;

КонецПроцедуры

// Обрабатывает событие редактора. В режиме «только просмотр» допускает только EVENT_GET_METADATA (подсказки).
Процедура ОбработатьСобытиеСУчетомРежимаЧтения(Форма, Событие) Экспорт

	Если Событие = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Форма.конс_ТолькоДляЧтения Тогда
		Если Событие.event <> "EVENT_GET_METADATA"
			И Событие.event <> "EVENT_GET_DEFINITION"
			И Событие.event <> "EVENT_THEME_CHANGED" Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ОбработатьСобытиеРедактора(Форма, Событие);

КонецПроцедуры

