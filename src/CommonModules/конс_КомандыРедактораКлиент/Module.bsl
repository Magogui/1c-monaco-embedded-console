
#Область ПрограммныйИнтерфейс

// Управляет видимостью строки состояния
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Объект формы, содержащей элемент управления 'конс_Код'
Процедура УправлениеВидимостьюСтрокиСостояния(Форма) Экспорт

	Форма.Элементы.конс_СтрокаСостояния.Пометка = Форма.конс_ВидимостьСтрокиСостояния;
	
	Если Форма.конс_ВидимостьСтрокиСостояния Тогда
		View(Форма).showStatusBar();
	Иначе
		View(Форма).hideStatusBar();
	КонецЕсли;

КонецПроцедуры

// Устанавливает пометку на кнопку Быстрые подсказки
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Объект формы, содержащей элемент управления 'конс_Код'
Процедура УправлениеБыстрымиПодсказками(Форма) Экспорт

	Форма.Элементы.конс_БыстрыеПодсказки.Пометка = Форма.конс_БыстрыеПодсказки;

КонецПроцедуры

// Возвращает представление по умолчанию документа из элемента управления 'конс_Код' на форме
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Объект формы, содержащей элемент управления 'конс_Код'
// 
// Возвращаемое значение:
// Неопределено - Представление документа или Неопределено, если отсутствует
Функция View(Форма) Экспорт

	Возврат Форма.Элементы.конс_Код.Документ.defaultView;

КонецФункции

// Переключает состояние быстрых подсказок в форме и управляет их отображением
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Объект формы, для которой управляются быстрые подсказки
Процедура БыстрыеПодсказки(Форма) Экспорт

	Форма.конс_БыстрыеПодсказки = Не Форма.конс_БыстрыеПодсказки;
	View(Форма).enableQuickSuggestions(Форма.конс_БыстрыеПодсказки);
	УправлениеБыстрымиПодсказками(Форма);

КонецПроцедуры

// Вставляет новую строку с указанным текстом в форму на заданную позицию
// 
// Параметры:
//  Форма  - ФормаКлиентскогоПриложения - форма, в которую вставляется строка
//  НомерСтроки - Число  - Позиция (индекс) для вставки новой строки
//  Текст       - Строка - Текст, который будет вставлен в новую строку
Процедура ВставитьСтроку(Форма, НомерСтроки, Текст) Экспорт

	View(Форма).insertLine(НомерСтроки, Текст);

КонецПроцедуры

// Асинхронно вызывает конструктор запроса для формы с возможностью задания параметров и начального текста запроса
// 
// Параметры:
//  Форма           - ФормаКлиентскогоПриложения        - Объект формы, для которой вызывается конструктор запроса
//  ПараметрыВызова - Произвольный - Необязательные параметры вызова конструктора запроса
Асинх Процедура ВызватьКонструкторЗапроса(Форма, ПараметрыВызова = Неопределено) Экспорт

	ДанныеЗапроса = ДанныеДляКонструктораЗапроса(ПараметрыВызова, Форма);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Форма", Форма);
	ДопПараметры.Вставить("НачальнаяПозиция", ДанныеЗапроса.НачальнаяПозиция);
	ДопПараметры.Вставить("КонечнаяПозиция", ДанныеЗапроса.КонечнаяПозиция);
	ДопПараметры.Вставить("ТекстЗапроса", ДанныеЗапроса.ТекстЗапроса);
	
	ТекстЗапроса = ДопПараметры.ТекстЗапроса;
	Если Не ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Результат = Ждать ВопросАсинх("Не найден текст запроса." + Символы.ПС + "Создать новый запрос?", РежимДиалогаВопрос.ДаНет);
	
		Если Результат = КодВозвратаДиалога.Да Тогда
			ОткрытьКонструкторЗапроса("", ДопПараметры);
		КонецЕсли;
	Иначе
		ПодготовитьТекстЗапросаККонструкторуЗапросов(ТекстЗапроса, Форма);
		ОткрытьКонструкторЗапроса(ТекстЗапроса, ДопПараметры);
	КонецЕсли;

КонецПроцедуры

