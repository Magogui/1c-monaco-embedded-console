#Область СлужебныеПроцедурыИФункции

// Возвращает выделенный фрагмент (при отсутствии выделения - весь текст редактора)
// и смещение строк фрагмента относительно начала текста для привязки маркеров ошибок.
//
// Возвращаемое значение:
//  Структура:
//   * Текст          - Строка
//   * СмещениеСтрок  - Число - (номер первой строки фрагмента в редакторе) - 1
Функция ТекстДляВыполнения(Форма)

	Фрагмент = Новый Структура("Текст, СмещениеСтрок", "", 0);

	Текст = ПолучитьВыделенныйТекст(Форма);

	Если ЗначениеЗаполнено(СокрЛП(Текст)) Тогда
		Строки = ПолучитьНомераСтрокВыделения(Форма);
		Фрагмент.СмещениеСтрок = Строки.startLine - 1;
	Иначе
		Текст = ПолучитьТекст(Форма);
	КонецЕсли;

	Фрагмент.Текст = Текст;

	Возврат Фрагмент;

КонецФункции

Процедура СброситьМаркерыОшибок(Форма)

	УстановитьМаркеры(Форма, "[]");

КонецПроцедуры

// Выводит результат выполнения в нижнюю панель дерева значений редактора,
// а при ошибке дополнительно ставит маркер на строку с ошибкой.
Процедура ПоказатьРезультатВыполнения(Форма, Результат, Заголовок)

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	КореньДерева = Новый Соответствие;

	Узел = Новый Структура;
	Узел.Вставить("label", Заголовок);

	Если Результат.Успех Тогда
		Узел.Вставить("type", СтрШаблон("успешно, %1 мс", Формат(Результат.Длительность, "ЧГ=0")));
		Узел.Вставить("icon", "boolean.png");
	Иначе
		Узел.Вставить("type", "ошибка");
		Узел.Вставить("value", Результат.ОписаниеОшибки);
		Узел.Вставить("icon", "null.png");
	КонецЕсли;

	Дети = Новый Соответствие;
	НомерУзла = 0;

	Если Не Результат.Успех И ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
		УзелОшибки = Новый Структура;
		УзелОшибки.Вставить("label", "Ошибка");
		УзелОшибки.Вставить("value", Результат.ОписаниеОшибки);
		УзелОшибки.Вставить("icon", "null.png");
		УзелОшибки.Вставить("class", "final");
		Дети.Вставить("exec_error", УзелОшибки);
		НомерУзла = НомерУзла + 1;
	КонецЕсли;

	Для Каждого Сообщение Из Результат.Сообщения Цикл
		УзелСообщения = Новый Структура;
		УзелСообщения.Вставить("label", Сообщение);
		УзелСообщения.Вставить("icon", "text.png");
		УзелСообщения.Вставить("class", "final");
		Дети.Вставить("exec_msg_" + Формат(НомерУзла, "ЧГ=0"), УзелСообщения);
		НомерУзла = НомерУзла + 1;
	КонецЦикла;

	Если Результат.Свойство("КоличествоСтрок") И Результат.Успех Тогда
		УзелИтога = Новый Структура;
		УзелИтога.Вставить("label", "Результат запроса");
		УзелИтога.Вставить("type", СтрШаблон("строк: %1", Формат(Результат.КоличествоСтрок, "ЧГ=0")));
		УзелИтога.Вставить("value", СтрСоединить(Результат.Колонки, ", "));
		УзелИтога.Вставить("icon", "table.png");
		Если Результат.КоличествоСтрок > 0 Тогда
			// Раскрываемый узел: строки подгружаются по событию EVENT_GET_VARIABLE_DATA
			УзелИтога.Вставить("path", Результат.АдресРезультата);
		Иначе
			УзелИтога.Вставить("class", "final");
		КонецЕсли;
		Дети.Вставить("exec_query_result", УзелИтога);
	КонецЕсли;

	Если Дети.Количество() > 0 Тогда
		Узел.Вставить("children", Дети);
	Иначе
		Узел.Вставить("class", "final");
	КонецЕсли;

	КореньДерева.Вставить("exec_result", Узел);

	View(Форма).showVariablesDescription(ВСтрокуJSON(КореньДерева));

	Если Не Результат.Успех И Результат.СтрокаОшибки > 0
		И Результат.СтрокаОшибки <= View(Форма).getLineCount() Тогда
		Маркер = Новый Структура;
		Маркер.Вставить("lineNumber", Результат.СтрокаОшибки);
		Маркер.Вставить("severity", "Error");
		Маркер.Вставить("message", Результат.ОписаниеОшибки);
		Маркеры = Новый Массив;
		Маркеры.Добавить(Маркер);
		УстановитьМаркеры(Форма, ВСтрокуJSON(Маркеры));
		ПоказатьСтрокуВЦентре(Форма, Результат.СтрокаОшибки);
	КонецЕсли;

КонецПроцедуры

// Ленивое раскрытие узла результата запроса в дереве значений (событие EVENT_GET_VARIABLE_DATA из tree.js).
// В variablePath закодирован адрес временного хранилища и, через "|", индекс строки таблицы.
Процедура ОбработатьЗапросДанныхПеременной(Форма, ПараметрыСобытия)

	Путь = ПараметрыСобытия.variablePath;

	Если Не ЗначениеЗаполнено(Путь) Тогда
		Возврат;
	КонецЕсли;

	Части = СтрРазделить(Путь, "|");
	Адрес = Части[0];

	Если Не ЭтоАдресВременногоХранилища(Адрес) Тогда
		Возврат;
	КонецЕсли;

	ИндексСтроки = -1;
	Если Части.Количество() > 1 Тогда
		Попытка
			ИндексСтроки = Число(Части[1]);
		Исключение
			Возврат;
		КонецПопытки;
	КонецЕсли;

	Ветка = конс_ВыполнениеКодаВызовСервера.ОписаниеВеткиРезультата(Адрес,
		ПараметрыСобытия.variableId, ИндексСтроки);

	View(Форма).updateVariableDescription(ПараметрыСобытия.variableId, ВСтрокуJSON(Ветка));

КонецПроцедуры

// Вызывает выбор типа для плейсхолдеров сниппетов "ВыборТипа" и "КонструкторОписанияТипов"
Процедура ВызватьКонструкторТипа(Форма, ОписаниеТипов)

	ИменаТипов = "Строка, Число, Дата, Булево, УникальныйИдентификатор, Массив, Структура, Соответствие,
		|СписокЗначений, ТаблицаЗначений, ДеревоЗначений, ОписаниеТипов, ДвоичныеДанные, Произвольный";

	СписокТипов = Новый СписокЗначений;
	Для Каждого ИмяТипа Из СтрРазделить(ИменаТипов, ",") Цикл
		СписокТипов.Добавить(СокрЛП(ИмяТипа));
	КонецЦикла;

	ДопПараметры = Новый Структура("Форма, ОписаниеТипов", Форма, ОписаниеТипов);
	Оповещение = Новый ОписаниеОповещения("ЗавершитьВыборТипа", ЭтотОбъект, ДопПараметры);

	СписокТипов.ПоказатьВыборЭлемента(Оповещение, "Выбор типов");

КонецПроцедуры

Процедура ЗавершитьВыборТипа(ВыбранныйЭлемент, ДопПараметры) Экспорт

	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИмяТипа = ВыбранныйЭлемент.Значение;

	Если ДопПараметры.ОписаниеТипов Тогда
		Текст = СтрШаблон("Новый ОписаниеТипов(""%1"")", ИмяТипа);
	Иначе
		Текст = СтрШаблон("Тип(""%1"")", ИмяТипа);
	КонецЕсли;

	УстановитьТекст(ДопПараметры.Форма, Текст, Неопределено, Ложь);

КонецПроцедуры

// Текст для статус-бара: итог и длительность выполнения
Функция ТекстДлительностиВыполнения(Результат)

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Длительность = 0;
	Если Не Результат.Свойство("Длительность", Длительность) Тогда
		Длительность = 0;
	КонецЕсли;

	Итог = ?(Результат.Успех, "Выполнено", "Ошибка выполнения");

	Если Длительность >= 1000 Тогда
		Возврат СтрШаблон("%1 за %2 сек", Итог, Формат(Длительность / 1000, "ЧДЦ=1"));
	ИначеЕсли Длительность > 0 Тогда
		Возврат СтрШаблон("%1 за %2 мс", Итог, Формат(Длительность, "ЧГ=0"));
	КонецЕсли;

	Возврат Итог;

КонецФункции

Процедура СохранитьНастройкуРедактора(Имя, Значение)

	Настройки = конс_ИнициализацияРедактораВызовСервера.НастройкиРедактора();

	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Настройки = Новый Структура;
	КонецЕсли;

	Настройки.Вставить(Имя, Значение);

	конс_ИнициализацияРедактораВызовСервера.СохранитьНастройкиРедактора(Настройки);

КонецПроцедуры

Функция ВСтрокуJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);

	Возврат Запись.Закрыть();

КонецФункции

Асинх Процедура ВызватьКонструкторФорматнойСтроки(Форма, ПараметрыСтроки)

	Если ПараметрыСтроки = Неопределено Тогда
		ТекстВопроса = "Форматная строка не найдена." + Символы.ПС + "Создать новую форматную строку?";
		Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
		Если Результат <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	
		ФорматнаяСтрока = "";
		Позиция = Неопределено;
	Иначе
		ФорматнаяСтрока = СтрЗаменить(СтрЗаменить(ПараметрыСтроки.text, "|", ""), """", "");
		Позиция = ПараметрыСтроки.range;
	КонецЕсли;
	
	Конструктор = Новый КонструкторФорматнойСтроки;
	Попытка
		Конструктор.Текст = ФорматнаяСтрока;
	Исключение
		Инфо = ИнформацияОбОшибке();
		ПоказатьПредупреждение( , "Ошибка в тексте форматной строки:" + Символы.ПС + Инфо.Причина.Описание);
		Возврат;
	КонецПопытки;
	
	ФорматнаяСтрока = Ждать Конструктор.ОткрытьАсинх();
	
	Если ФорматнаяСтрока <> Неопределено Тогда
		ФорматнаяСтрока = СтрЗаменить(ФорматнаяСтрока, "'", "");
		ФорматнаяСтрока = """" + ФорматнаяСтрока + """";
		УстановитьТекст(Форма, ФорматнаяСтрока, Позиция, Ложь);
	КонецЕсли;

КонецПроцедуры

Функция ДанныеДляКонструктораЗапроса(Знач ПараметрыВызова, Знач Форма)

	ТекстЗапроса = "";
	НачальнаяПозиция = 0;
	КонечнаяПозиция = 0;
	Если ПараметрыВызова = Неопределено Тогда
	
		Если View(Форма).queryMode Тогда
			ТекстЗапроса = ПолучитьТекст(Форма);
		Иначе
			// Попытаемся извлечь текст запроса из выделенного текста
			ТекстЗапроса = ПолучитьВыделенныйТекст(Форма);
	
			Строки = ПолучитьНомераСтрокВыделения(Форма);
			НачальнаяПозиция = Строки.startLine;
			КонечнаяПозиция = Строки.endLine;
		КонецЕсли;
	
	Иначе
		НачальнаяПозиция = ПараметрыВызова.range.startLineNumber;
		КонечнаяПозиция = ПараметрыВызова.range.endLineNumber;
		ТекстЗапроса = ПараметрыВызова.text;
	КонецЕсли;
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("НачальнаяПозиция", НачальнаяПозиция);
	ДанныеЗапроса.Вставить("КонечнаяПозиция", КонечнаяПозиция);
	ДанныеЗапроса.Вставить("ТекстЗапроса", ТекстЗапроса);
	
	Возврат ДанныеЗапроса;

КонецФункции

Асинх Процедура ОткрытьКонструкторЗапроса(ТекстЗапроса, ДопПараметры)

	Попытка
		Конструктор = Новый КонструкторЗапроса(ТекстЗапроса);
	Исключение
		Инфо = ИнформацияОбОшибке();
		ПоказатьПредупреждение( , "Ошибка в тексте запроса:" + Символы.ПС + Инфо.Причина.Описание);
		Возврат;
	КонецПопытки;
	
	ТекстЗапроса = Ждать Конструктор.ОткрытьАсинх();
	
	УстановитьТекстЗапроса(ТекстЗапроса, ДопПараметры);

КонецПроцедуры

Процедура ПодготовитьТекстЗапросаККонструкторуЗапросов(ТекстЗапроса, Форма)

	Если Не View(Форма).queryMode Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "|", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """""", "$");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "$", """");
	КонецЕсли;

КонецПроцедуры

Процедура ПодготовитьТекстЗапросаКРедакторуКода(ТекстЗапроса, Форма)

	Если Не View(Форма).queryMode Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, Символы.ПС, Символы.ПС + "|");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, """", """""");
		ТекстЗапроса = """" + ТекстЗапроса + """";
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьТекущуюТему(Форма)

	Возврат View(Форма).getTheme();

КонецФункции

Процедура УстановитьТекстЗапроса(ТекстЗапроса, Знач ДопПараметры)

	Форма = ДопПараметры.Форма;
	
	Если ТекстЗапроса <> Неопределено Тогда
	
		Если View(Форма).queryMode Тогда
			ОчиститьТекст(Форма);
			УстановитьТекст(Форма, ТекстЗапроса, Неопределено, Истина);
		Иначе
			ПодготовитьТекстЗапросаКРедакторуКода(ТекстЗапроса, Форма);
			ЗаменитьТекстПоНомерамСтрок(Форма, ТекстЗапроса, ДопПараметры.НачальнаяПозиция,
				ДопПараметры.КонечнаяПозиция);
		КонецЕсли;
	
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

