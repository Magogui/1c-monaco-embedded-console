КонецПроцедуры

// Переключает режим синтаксической подсветки для текста запроса в форме между режимами BSL и BSL Query
// 
// Параметры:
//  Форма        - ФормаКлиентскогоПриложения - Объект формы, содержащей текстовое поле для запроса
//  РежимЗапроса - Булево - Признак режима: Истина - BSL Query, Ложь - BSL
Процедура ПереключитьРежимЗапроса(Форма, РежимЗапроса) Экспорт

	ИдентификаторРежима = ?(РежимЗапроса, "bsl_query", "bsl");
	
	ТекстЗапроса = ПолучитьТекст(Форма);
	
	View(Форма).setLanguageMode(ИдентификаторРежима);
	
	View(Форма).updateText(ТекстЗапроса, Ложь, Истина);

КонецПроцедуры

// Переключает режим подсветки запросов в форме консоли и устанавливает соответствующую тему оформления
// 
// Параметры:
//  Форма - Форма - Объект формы консоли, для которой выполняется переключение подсветки запросов
Процедура ПодсвечиватьЗапросы(Форма) Экспорт

	Форма.конс_ПодсвечиватьЗапросы = Не Форма.конс_ПодсвечиватьЗапросы;
	Форма.Элементы.конс_ПодсвечиватьЗапросы.Пометка = Форма.конс_ПодсвечиватьЗапросы;
	ИмяТемы = ПолучитьТекущуюТему(Форма);
	ИмяТемы = ИмяТемы + ?(Форма.конс_ПодсвечиватьЗапросы, "-query", "");
	УстановитьТему(Форма, ИмяТемы);

КонецПроцедуры

