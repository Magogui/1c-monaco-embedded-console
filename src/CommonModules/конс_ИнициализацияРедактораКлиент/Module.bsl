#Область ПрограммныйИнтерфейс

// Устанавливает флаг загруженности документа и, в зависимости от типа клиента, инициализирует редактор и включает дополнительные функции, либо выводит предупреждение о недоступности функций в веб-клиенте.
// 
// Параметры:
//  Элемент - Неопределено               - Элемент, для которого сформирован документ (параметр не используется в теле процедуры)
//  Форма   - ФормаКлиентскогоПриложения - Форма, в которой сформирован документ
Процедура ДокументСформирован(Элемент, Форма) Экспорт

	Если Форма.конс_ДокументЗагружен Тогда
		Возврат;
	КонецЕсли;

	Форма.конс_ДокументЗагружен = Истина;
	
	#Если ВебКлиент Тогда
	Если ВебДокументДоступен(Форма) Тогда
		ИнициализацияРедактора(Форма);
		АктивироватьДополнительныеФункции(Форма);
	Иначе
		Форма.конс_ДокументЗагружен = Ложь;
		ПоказатьПредупреждение( , "К сожалению, в веб-клиенте недоступны практически все функции.
								  |Вы можете посмотреть только работу автодополнения и подсказок параметров при наборе кода.");
	КонецЕсли;
	#Иначе
		ИнициализацияРедактора(Форма);
		АктивироватьДополнительныеФункции(Форма);
	#КонецЕсли

КонецПроцедуры

// Вызывается из JS-события EVENT_EDITOR_READY, когда Monaco создал редактор.
// ДокументСформирован в 1С часто срабатывает раньше, чем загрузятся скрипты.
Процедура ПриГотовностиРедактора(Форма) Экспорт

	УжеИнициализирован = Форма.конс_ДокументЗагружен;

	Если УжеИнициализирован Тогда
		ИнициализацияРедактора(Форма);
	Иначе
		ДокументСформирован(Неопределено, Форма);
	КонецЕсли;

	// Редактор мог появиться позже init() — повторяем начальное заполнение на форме
	Если УжеИнициализирован Тогда
		Оповестить("конс_РедакторГотов", , Форма);
	КонецЕсли;

КонецПроцедуры

// Повтор init, пока HTML-документ и defaultView не готовы (вызывается обработчиком ожидания на форме).
Процедура ПовторИнициализацииКонсоли(Форма) Экспорт

	Если Форма.конс_ДокументЗагружен Тогда
		Возврат;
	КонецЕсли;

	Если Не Форма.конс_ИсходникиЗагружены Тогда
		Возврат;
	КонецЕсли;

	Счетчик = 0;
	Если Форма.Свойство("конс_ПопытокИнициализации") Тогда
		Счетчик = Форма.конс_ПопытокИнициализации;
	КонецЕсли;
	Счетчик = Счетчик + 1;
	Если Форма.Свойство("конс_ПопытокИнициализации") Тогда
		Форма.конс_ПопытокИнициализации = Счетчик;
	КонецЕсли;

	ПопыткаИнициализироватьПослеПодключения(Форма);

	Если Не Форма.конс_ДокументЗагружен Тогда
		Если Счетчик >= 40 Тогда
			Текст = "Редактор не ответил за ~20 с."
				+ Символы.ПС + "1. Обновите конфигурацию из EDT (макет конс_src)."
				+ Символы.ПС + "2. Выполните команду «Обновить консоль» (очистка %TEMP%\bsl_console)."
				+ Символы.ПС + "3. Откройте файл в браузере — если там работает, проблема в CEF 1С:"
				+ Символы.ПС + Форма.конс_HTML;
			ПоказатьПредупреждение(, Текст);
			Возврат;
		КонецЕсли;
		ЗапланироватьПовторнуюИнициализацию(Форма);
	КонецЕсли;

КонецПроцедуры

// Планирует повторную попытку init на форме (нужна процедура конс_ПовторИнициализацииКонсоли).
Процедура ЗапланироватьПовторнуюИнициализацию(Форма, ИнтервалСек = 0.5) Экспорт

	Попытка
		Форма.ПодключитьОбработчикОжидания("конс_ПовторИнициализацииКонсоли", ИнтервалСек, Истина);
	Исключение
	КонецПопытки;

КонецПроцедуры

// Обновляет значок (картинку) на вкладке в зависимости от наличия кода
// 
// Параметры:
//  Форма             - ФормаКлиентскогоПриложения - Форма, в которой размещены элементы
//  ВыбраннаяСтраница - Булево                     - Ключ страницы, для которой нужно обновить картинку
//  КодЗаполнен       - Булево                     - Признак, что на странице есть код
Процедура ОбновитьКартинкуКода(Форма, ВыбраннаяСтраница = Неопределено, КодЗаполнен = Ложь) Экспорт

	Если ЗначениеЗаполнено(ВыбраннаяСтраница) Тогда
		УстановитьКартинкуСтраницы(Форма, ВыбраннаяСтраница, КодЗаполнен);
		Возврат;
	КонецЕсли;
	
	Для Каждого Страница Из Форма.конс_СоответствияКодовНаСтранице Цикл
		ДанныеСтраницы = Страница.Значение;
		УстановитьКартинкуСтраницы(Форма, Страница.Ключ, ДанныеСтраницы.КодЗаполнен);
	КонецЦикла;

КонецПроцедуры

// Обрабатывает событие получения метаданных для редактора кода, загружает структуру модулей или объектов по запросу и управляет подсказками
// 
// Параметры:
//  Форма   - ФормаКлиентскогоПриложения - Форма, в которой размещен редактор кода
//  Событие - Структура                  - Содержит параметры запроса: trigger (тип события), metadata (метаданные для загрузки), snippet_guid (идентификатор сниппета)
Процедура ОбработкаСобытияПолученияМетаданных(Форма, Событие) Экспорт

	ПараметрыЗапроса = НРег(Событие.metadata);
	ДанныеОбновлены = Ложь;
	
	Если 0 < СтрНайти(ПараметрыЗапроса, ".") Тогда
	
		ЧастиЗапроса = СтрРазделить(ПараметрыЗапроса, ".");
	
		Если ЧастиЗапроса[0] = "module" Тогда
	
			Если ЧастиЗапроса.Количество() = 2 Тогда
				ДанныеОбновлены = ЗагрузитьСтруктуруОбщегоМодуляПоЗапросу(Форма, ЧастиЗапроса);
			Иначе
				ДанныеОбновлены = ЗагрузитьСтруктуруМодуляМенеджераИлиОбъектаПоЗапросу(Форма, ЧастиЗапроса);
			КонецЕсли;
	
		Иначе
	
			ДанныеОбновлены = ЗагрузитьОбъектМетаданныхПоЗапросу(Форма, ПараметрыЗапроса);
	
		КонецЕсли;
	
	Иначе
	
		ДанныеОбновлены = ЗагрузитьСписокМетаданныхПоЗапросу(Форма, ПараметрыЗапроса);
	
	КонецЕсли;
	
	Если Событие.trigger = "suggestion" И ДанныеОбновлены Тогда
		конс_КомандыРедактораКлиент.View(Форма).triggerSuggestions();
	КонецЕсли;
	
	Если Событие.trigger = "snippet" Тогда
		конс_КомандыРедактораКлиент.View(Форма).updateSnippetByGUID(Событие.snippet_guid);
	КонецЕсли;

КонецПроцедуры

// Выполняет действия перед закрытием формы: в не-веб-клиентском режиме асинхронно удаляет временные файлы консоли.
// Вызывайте из обработчика формы только с Ждать, чтобы удаление не начиналось до завершения закрытия документа HTML.
// 
// Параметры:
//  Форма                - ФормаКлиентскогоПриложения - Экземпляр формы, которую обрабатывает процедура
//  Отказ                - Булево                     - Определяет, следует ли отменить закрытие формы
//  ЗавершениеРаботы     - Булево                     - Признак того, что выполняется завершение работы приложения
//  ТекстПредупреждения  - Строка                     - Текст предупреждающего сообщения, которое может быть показано пользователю
//  СтандартнаяОбработка - Булево                     - Указывает, следует ли выполнять стандартную обработку события закрытия формы
Асинх Функция ПередЗакрытием(Форма, Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка) Экспорт

	#Если Не ВебКлиент Тогда
	
	Ждать ЗакрытьКонсольАсинх(Форма);
	
	#КонецЕсли

	Возврат Неопределено;

КонецФункции

// Выполняет действия перед записью данных формы, сохраняет текущий программный код с активной страницы редактора в соответствии с ее ключом
// 
// Параметры:
//  Форма           - ФормаКлиентскогоПриложения - Объект формы, с которой работает метод
//  Отказ           - Булево                     - Определяет, следует ли отменить запись данных формы
//  ПараметрыЗаписи - Неопределено               - Параметры выполняемой записи, специфичные для конкретного действия
Процедура ПередЗаписью(Форма, Отказ, ПараметрыЗаписи) Экспорт

	// последняя используемая страница с кодом
	ТекущаяСтраница = Форма.конс_КлючАктивнойСтраницы;
	
	// получаем текущий код
	ТекущийКод = конс_КомандыРедактораКлиент.ПолучитьТекст(Форма);
	
	Соответствие = Неопределено;
	// сохраняем текущий код по ключу страницы
	ЕстьКодНаТекущейСтранице = Форма.конс_СоответствияКодовНаСтранице.Свойство(ТекущаяСтраница, Соответствие);
	Если ЕстьКодНаТекущейСтранице Тогда
		Соответствие.Вставить("Код", ТекущийКод);
	КонецЕсли;

КонецПроцедуры

// Извлекает имя модуля из пути файла и читает его текстовое содержимое
// 
// Параметры:
//  ПолноеИмяФайла - Строка - Полный путь к файлу модуля на диске
// 
// Возвращаемое значение:
// Структура:
// * Имя - Строка - имя модуля
// * Текст - Строка - текст модуля
Функция ПолучитьМодульИзИсходников(ПолноеИмяФайла) Экспорт
	
	#Если Не ВебКлиент Тогда
	
	СмещениеИмениВПути = 2;
	
	Путь = СтрРазделить(ПолноеИмяФайла, ПолучитьРазделительПути(), Ложь);
	ИмяМодуля = Путь[Путь.Количество() - СмещениеИмениВПути];
	
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ПолноеИмяФайла, "UTF-8");
	ТекстМодуля = Текст.ПолучитьТекст();
	
	Возврат Новый Структура("Имя, Текст", ИмяМодуля, ТекстМодуля);
	
	#Иначе
	
	Возврат Новый Структура("Имя, Текст", "", "");
	
	#КонецЕсли
	
КонецФункции

// Переход к определению (событие EVENT_GET_DEFINITION): открывает модуль из каталога исходников
// в форме просмотра с позиционированием на функции либо ищет определение в текущем редакторе.
//
// Параметры:
//  Форма             - ФормаКлиентскогоПриложения - форма с редактором
//  ПараметрыСобытия  - Структура - параметры события (word, expression, module, class, line, column)
Процедура ОткрытьОпределение(Форма, ПараметрыСобытия) Экспорт

	#Если Не ВебКлиент Тогда

	ИмяМодуля = ПараметрыСобытия.module;

	Если ЗначениеЗаполнено(ИмяМодуля) Тогда

		КаталогИсходногоКода = ПолучитьКаталогИсходногоКода();

		Если ЗначениеЗаполнено(КаталогИсходногоКода) Тогда

			ИмяВКонфигураторе = Форма.конс_ИменаОбщихМодулей.Получить(НРег(ИмяМодуля));
			Если ИмяВКонфигураторе = Неопределено Тогда
				ИмяВКонфигураторе = ИмяМодуля;
			КонецЕсли;

			ФайлМодуля = СтрШаблон("%1CommonModules%2%3%2Module.bsl", КаталогИсходногоКода,
				ПолучитьРазделительПути(), ИмяВКонфигураторе);

			ФайлНаДиске = Новый Файл(ФайлМодуля);

			Если ФайлНаДиске.Существует() Тогда
				Модуль = ПолучитьМодульИзИсходников(ФайлНаДиске.ПолноеИмя);
				ОткрытьМодульНаПросмотр(Форма, Модуль.Имя, Модуль.Текст, ПараметрыСобытия.word);
				Возврат;
			КонецЕсли;

		КонецЕсли;

		Возврат;

	КонецЕсли;

	// Модуль не указан - ищем определение в текущем редакторе
	конс_КомандыРедактораКлиент.View(Форма).goToFuncDefinition(ПараметрыСобытия.word);

	#КонецЕсли

КонецПроцедуры

// Обрабатывает переключение между вкладками редактора кода: сохраняет текущий код при уходе со вкладки, восстанавливает или очищает код при активации новой вкладки
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Экземпляр формы, содержащей редактор кода и связанные элементы управления
// 
// Возвращаемое значение:
// Булево - Признак наличия кода на активированной вкладке
Функция ПриИзмененииВкладкиСКодом(Форма) Экспорт

	АктивированнаяВкладка = Форма.конс_КлючАктивированнойСтраницы;
	
	// проверяем есть ли консоль на текущей странице
	ТекСтраница = Форма.конс_КлючАктивнойСтраницы;
	
	ЕстьКодНаТекущейСтранице = Форма.конс_СоответствияКодовНаСтранице.Свойство(ТекСтраница);
	Если ЕстьКодНаТекущейСтранице Тогда
		
		// получаем текущий код
		ТекущийКод = конс_КомандыРедактораКлиент.ПолучитьТекст(Форма);
		КодЗаполнен = ЗначениеЗаполнено(ТекущийКод);
		
		// сохраняем текущий код по ключу страницы
		Соответствие = Форма.конс_СоответствияКодовНаСтранице[ТекСтраница];
		Соответствие.Вставить("Код", ТекущийКод);
		Соответствие.Вставить("КодЗаполнен", КодЗаполнен);
	
		ОбновитьКартинкуКода(Форма, ТекСтраница, КодЗаполнен);
	
	КонецЕсли;
	
	// очищаем код страницы
	конс_КомандыРедактораКлиент.ОчиститьТекст(Форма, Истина);
	
	// проверяем есть ли консоль на следующей странице
	ЕстьКодНаСтранице = Форма.конс_СоответствияКодовНаСтранице.Свойство(АктивированнаяВкладка);
	
	Если ЕстьКодНаСтранице Тогда
		
		// устанавливаем код текущей страницы
		Соответствие = Форма.конс_СоответствияКодовНаСтранице[АктивированнаяВкладка];
		ПрограммныйКод = Соответствие.Код;
	
		конс_КомандыРедактораКлиент.ОбновитьТекст(Форма, ПрограммныйКод, Истина, Истина);
	КонецЕсли;
	
	// помещаем ключ текущей страницы в реквизит активной страницы
	Форма.конс_КлючАктивнойСтраницы = АктивированнаяВкладка;
	
	Возврат ЕстьКодНаСтранице;

КонецФункции

// Асинхронно выполняет инициализацию консоли при открытии формы, подключает расширение работы с файлами и, при успешном подключении, интегрирует консоль с формой
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Экземпляр формы, с которой будет интегрироваться консоль
Асинх Функция ПриОткрытии(Форма) Экспорт

	Подключено = Ждать ПодключитьРасширениеРаботыСФайламиАсинх();
	
#Если ВебКлиент Тогда
	Если Не Подключено Тогда
		Ждать УстановитьРасширениеРаботыСФайламиАсинх();
		Подключено = Ждать ПодключитьРасширениеРаботыСФайламиАсинх();
	КонецЕсли;
#КонецЕсли
	
	Если Подключено Тогда
		Ждать ПодключитьКонсольКФормеАсинх(Форма);
		ПопыткаИнициализироватьПослеПодключения(Форма);
		ЗапланироватьПовторнуюИнициализацию(Форма);
	Иначе
		ПоказатьПредупреждение( , "Не подключено расширение работы с файлами. Консоль кода не может быть загружена.");
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Если ДокументСформирован сработал до готовности исходников, повторяем init после ПриОткрытии.
Процедура ПопыткаИнициализироватьПослеПодключения(Форма)

	Если Не Форма.конс_ИсходникиЗагружены Или Форма.конс_ДокументЗагружен Тогда
		Возврат;
	КонецЕсли;

	Попытка
		конс_КомандыРедактораКлиент.View(Форма);
	Исключение
		Возврат;
	КонецПопытки;

	ДокументСформирован(Неопределено, Форма);

КонецПроцедуры

Процедура АктивироватьДополнительныеФункции(Форма)

	Если Форма.Элементы.Найти("конс_ТолькоДляЧтения") <> Неопределено Тогда
	
		Форма.Элементы.конс_КонструкторЗапроса.Доступность = Истина;
		Форма.Элементы.конс_ТолькоДляЧтения.Доступность = Истина;
		Форма.Элементы.конс_БыстрыеПодсказки.Доступность = Истина;
		Форма.Элементы.конс_ПодсвечиватьЗапросы.Доступность = Истина;
		Форма.Элементы.конс_СтрокаСостояния.Доступность = Истина;
	
		конс_КомандыРедактораКлиент.УправлениеБыстрымиПодсказками(Форма);
		конс_КомандыРедактораКлиент.УправлениеВидимостьюСтрокиСостояния(Форма);
		конс_КомандыРедактораКлиент.СовременныеВозможностиMonaco(Форма, Истина);

	КонецЕсли;

	АктивироватьВыполнениеКода(Форма);

	// Генерация события EVENT_GET_DEFINITION при переходе к определению (Ctrl+клик, F12)
	конс_КомандыРедактораКлиент.View(Форма).setOption("generateDefinitionEvent", Истина);

	ПрименитьСохраненныеНастройки(Форма);

КонецПроцедуры

// Восстанавливает пользовательские настройки редактора из хранилища системных настроек
Процедура ПрименитьСохраненныеНастройки(Форма)

	Настройки = конс_ИнициализацияРедактораВызовСервера.НастройкиРедактора();

	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Значение = Неопределено;

	Если Настройки.Свойство("Тема", Значение) И ЗначениеЗаполнено(Значение) Тогда
		конс_КомандыРедактораКлиент.УстановитьТему(Форма, Значение, Ложь);
	КонецЕсли;

	Если Настройки.Свойство("Миникарта", Значение) Тогда
		конс_КомандыРедактораКлиент.Миникарта(Форма, Значение, Ложь);
	КонецЕсли;

	Если Настройки.Свойство("НомераСтрок", Значение) Тогда
		Если Значение Тогда
			конс_КомандыРедактораКлиент.ПоказатьНомераСтрок(Форма, Ложь);
		Иначе
			конс_КомандыРедактораКлиент.СкрытьНомераСтрок(Форма, Ложь);
		КонецЕсли;
	КонецЕсли;

	Если Настройки.Свойство("СовременныеВозможности", Значение) Тогда
		конс_КомандыРедактораКлиент.СовременныеВозможностиMonaco(Форма, Значение);
	КонецЕсли;

КонецПроцедуры

Процедура ОткрытьМодульНаПросмотр(Форма, ИмяМодуля, ТекстМодуля, ИмяФункции)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", ИмяМодуля + " (только просмотр)");
	ПараметрыФормы.Вставить("Код", ТекстМодуля);
	ПараметрыФормы.Вставить("конс_HTML", Форма.конс_HTML);
	ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
	ПараметрыФормы.Вставить("ИмяФункции", ИмяФункции);

	ОткрытьФорму("ОбщаяФорма.конс_РедактированиеКода", ПараметрыФормы, Форма);

КонецПроцедуры

// Включает команды выполнения кода и горячую клавишу Ctrl+Enter,
// если на форме есть кнопка конс_ВыполнитьКод и у пользователя есть право выполнения
Процедура АктивироватьВыполнениеКода(Форма)

	Если Форма.Элементы.Найти("конс_ВыполнитьКод") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВыполнениеДоступно = конс_КомандыРедактораКлиент.ВыполнениеКодаДоступно();

	Форма.Элементы.конс_ВыполнитьКод.Видимость = ВыполнениеДоступно;
	Если Форма.Элементы.Найти("конс_ВыполнитьЗапрос") <> Неопределено Тогда
		Форма.Элементы.конс_ВыполнитьЗапрос.Видимость = ВыполнениеДоступно;
	КонецЕсли;
	Если Форма.Элементы.Найти("конс_ПредыдущийКод") <> Неопределено Тогда
		Форма.Элементы.конс_ПредыдущийКод.Видимость = ВыполнениеДоступно;
	КонецЕсли;

	Если ВыполнениеДоступно Тогда
		// Ctrl+Enter = KeyMod.CtrlCmd (2048) | KeyCode.Enter (3)
		конс_КомандыРедактораКлиент.View(Форма).disableKeyBinding(2051);
	КонецЕсли;

КонецПроцедуры

Функция ВебДокументДоступен(Форма)

	Если Форма.Элементы.конс_Код.Документ <> Неопределено И Форма.Элементы.конс_Код.Документ.defaultView
		<> Неопределено Тогда
		Попытка
			конс_КомандыРедактораКлиент.ПолучитьТекст(Форма);
			Возврат Истина;
		Исключение
			Возврат Ложь;
		КонецПопытки;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

Асинх Функция ВывестиОшибкуАсинх(Текст, БлокироватьКонсоль, Форма)

	Ждать ПредупреждениеАсинх(Текст);
	
	Если БлокироватьКонсоль Тогда
		Форма.конс_Код.ТолькоПросмотр = Истина;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ЗагрузитьМодульМенеджераИлиОбъектаПоИмени(Форма, КаталогИсходногоКода, СтруктураВыгрузки)

	ЗагруженоФункций = 0;
	ТипМодуля = СтруктураВыгрузки.ТипМодуля;
	
	ИмяТипа = ?(ТипМодуля = "manager", "ManagerModule", "ObjectModule");
	
	ФайлМодуля = СтрШаблон("%1%2%3.bsl", СтруктураВыгрузки.ИмяКаталога, ПолучитьРазделительПути(), ИмяТипа);
	ФайлМодуля = КаталогИсходногоКода + ФайлМодуля;
	
	ФайлНаДиске = Новый Файл(ФайлМодуля);
	
	Если ФайлНаДиске.Существует() Тогда
		Модуль = ПолучитьМодульИзИсходников(ФайлНаДиске.ПолноеИмя);
		ИмяКоллекции = конс_ИнициализацияРедактораВызовСервера.ПолучитьИмяКоллекцииМетаданныхПоТипу(
			СтруктураВыгрузки.ТипМетаданных);
		АдресЗагрузки = СтрШаблон("%1.items.%2.%3", ИмяКоллекции, СтруктураВыгрузки.ИмяОбъектаМетаданных, ТипМодуля);
		ЗагруженоФункций = конс_КомандыРедактораКлиент.View(Форма).parseMetadataModule(Модуль.Текст, АдресЗагрузки);
	КонецЕсли;
	
	Возврат ЗагруженоФункций;

КонецФункции

Функция ЗагрузитьОбщийМодульПоИмени(Форма, КаталогИсходногоКода, ИмяМодуля, Глобальный)

	ЗагруженоФункций = 0;
	
	ИмяВКонфигураторе = Форма.конс_ИменаОбщихМодулей.Получить(НРег(ИмяМодуля));
	
	Если ИмяВКонфигураторе = Неопределено Тогда
		ИмяВКонфигураторе = ИмяМодуля;
	КонецЕсли;
	
	ФайлМодуля = СтрШаблон("CommonModules%1%2%1Module.bsl", ПолучитьРазделительПути(), ИмяВКонфигураторе);
	ФайлМодуля = КаталогИсходногоКода + ФайлМодуля;
	
	ФайлНаДиске = Новый Файл(ФайлМодуля);
	
	Если ФайлНаДиске.Существует() Тогда
		ОбщийМодуль = ПолучитьМодульИзИсходников(ФайлНаДиске.ПолноеИмя);
		ЗагруженоФункций = конс_КомандыРедактораКлиент.View(Форма).parseCommonModule(ОбщийМодуль.Имя, ОбщийМодуль.Текст, Глобальный);
	КонецЕсли;
	
	Возврат ЗагруженоФункций;

КонецФункции

Функция ЗагрузитьОбъектМетаданныхПоЗапросу(Форма, ПараметрыЗапроса)

	АдресОбновления = "";
	ОписаниеМетаданных = конс_ИнициализацияРедактораВызовСервера.ПолучитьОписаниеОбъектаМетаданных(ПараметрыЗапроса,
		АдресОбновления);
	
	Если ЗначениеЗаполнено(ОписаниеМетаданных) Тогда
	
		Если ТипЗнч(конс_КомандыРедактораКлиент.View(Форма).updateMetadata(ОписаниеМетаданных, АдресОбновления)) = Тип("Булево") Тогда
			Возврат Истина;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция ЗагрузитьСписокМетаданныхПоЗапросу(Форма, ПараметрыЗапроса)

	АдресОбновления = "";
	ОписаниеМетаданных = конс_ИнициализацияРедактораВызовСервера.ПолучитьСписокОбъектовМетаданных(ПараметрыЗапроса,
		АдресОбновления);
	
	Если ЗначениеЗаполнено(ОписаниеМетаданных) Тогда
	
		Если ТипЗнч(конс_КомандыРедактораКлиент.View(Форма).updateMetadata(ОписаниеМетаданных, АдресОбновления)) = Тип("Булево") Тогда
			Возврат Истина;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция ЗагрузитьСтруктуруМодуляМенеджераИлиОбъектаПоЗапросу(Форма, ЧастиЗапроса)

	КаталогИсходногоКода = ПолучитьКаталогИсходногоКода();
	КоличествоЧастейЗапроса = 4;
	
	Если ЗначениеЗаполнено(КаталогИсходногоКода) И ЧастиЗапроса.Количество() = КоличествоЧастейЗапроса Тогда
	
		СтруктураВыгрузки = Новый Структура;
		СтруктураВыгрузки.Вставить("ТипМодуля", ЧастиЗапроса[1]);
		СтруктураВыгрузки.Вставить("ТипМетаданных", ЧастиЗапроса[2]);
		СтруктураВыгрузки.Вставить("ОбъектМетаданных", ЧастиЗапроса[3]);
	
		конс_ИнициализацияРедактораВызовСервера.ДополнитьСтруктуруВыгрузкиИсходниковМетаданных(СтруктураВыгрузки,
			ПолучитьРазделительПути());
	
		Если ЗначениеЗаполнено(СтруктураВыгрузки.ИмяКаталога) Тогда
	
			ЗагруженоФункций = ЗагрузитьМодульМенеджераИлиОбъектаПоИмени(Форма, КаталогИсходногоКода, СтруктураВыгрузки);
	
			Если 0 < ЗагруженоФункций Тогда
				Возврат Истина;
			КонецЕсли;
	
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция ЗагрузитьСтруктуруОбщегоМодуляПоЗапросу(Форма, ЧастиЗапроса)

	КаталогИсходногоКода = ПолучитьКаталогИсходногоКода();
	КоличествоЧастейЗапроса = 2;
	
	Если ЗначениеЗаполнено(КаталогИсходногоКода) И ЧастиЗапроса.Количество() = КоличествоЧастейЗапроса Тогда
	
		ИмяМодуля = ЧастиЗапроса[1];
	
		ЗагруженоФункций = ЗагрузитьОбщийМодульПоИмени(Форма, КаталогИсходногоКода, ИмяМодуля, Ложь);
	
		Если 0 < ЗагруженоФункций Тогда
			Возврат Истина;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция СтрокаСостоитТолькоИзШестнадцатеричныхСимволов(Знач Текст)

	Текст = СокрЛП(Текст);
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(НРег(Текст), Индекс, 1);
		Если СтрНайти("0123456789abcdef", Символ) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

Функция НормализоватьЛокальныйПутьФайлаДляРаботыСДиском(Знач Путь)

	Путь = СокрЛП(Путь);
	Пн = НРег(Путь);
	Если СтрНайти(Пн, "file:///") = 1 Тогда
		Путь = Сред(Путь, 9);
	ИначеЕсли СтрНайти(Пн, "file://") = 1 Тогда
		Путь = Сред(Путь, 8);
	КонецЕсли;
	РазделительПути = ПолучитьРазделительПути();
	Путь = СтрЗаменить(Путь, "/", РазделительПути);

	Возврат СокрЛП(Путь);

КонецФункции

Функция КаталогСессииКонсолиПоПутиВременногоHtml(Знач ПутьКHtml)

	ПутьКHtml = НормализоватьЛокальныйПутьФайлаДляРаботыСДиском(ПутьКHtml);
	РазделительПути = ПолучитьРазделительПути();
	Части = СтрРазделить(ПутьКHtml, РазделительПути, Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат "";
	КонецЕсли;

	ИндексBsl = -1;
	Для Индекс = 0 По Части.Количество() - 1 Цикл
		Если НРег(Части[Индекс]) = "bsl_console" Тогда
			ИндексBsl = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ИндексBsl < 0 Тогда
		Возврат "";
	КонецЕсли;

	ИндексGuid = ИндексBsl + 1;
	// После каталога сессии (GUID) должна оставаться хотя бы одна компонента — имя файла (или подкаталог + файл).
	Если ИндексGuid >= Части.Количество() - 1 Тогда
		Возврат "";
	КонецЕсли;

	ИмяКаталогаСессии = Части[ИндексGuid];
	Если СтрДлина(ИмяКаталогаСессии) <> 32 Или Не СтрокаСостоитТолькоИзШестнадцатеричныхСимволов(ИмяКаталогаСессии) Тогда
		Возврат "";
	КонецЕсли;

	КаталогСессии = "";
	Для Индекс = 0 По ИндексGuid Цикл
		КаталогСессии = ?(КаталогСессии = "", Части[Индекс], КаталогСессии + РазделительПути + Части[Индекс]);
	КонецЦикла;

	Возврат НормализоватьПуть(КаталогСессии);

КонецФункции

Асинх Функция ЗакрытьКонсольАсинх(Форма)

	Если Не ЗначениеЗаполнено(Форма.конс_HTML) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПутьКонсоли = НормализоватьЛокальныйПутьФайлаДляРаботыСДиском(Форма.конс_HTML);
	ПутьНРег = НРег(ПутьКонсоли);
	Если СтрНайти(ПутьНРег, "http://") = 1 Или СтрНайти(ПутьНРег, "https://") = 1 Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Удаление только после ожидания в ПередЗакрытием (Ждать), чтобы поле HTML успело отпустить файлы.
	КаталогСессии = КаталогСессииКонсолиПоПутиВременногоHtml(ПутьКонсоли);
	Попытка
		Если ЗначениеЗаполнено(КаталогСессии) Тогда
			// Распаковка в подкаталоге сессии — удаляем весь каталог с ресурсами и временным index.html.
			Ждать УдалитьФайлыАсинх(КаталогСессии);
		Иначе
			// Старый вариант: временный html лежит прямо в общем каталоге bsl_console — удаляем только файл.
			Ждать УдалитьФайлыАсинх(ПутьКонсоли);
		КонецЕсли;
	Исключение
		Попытка
			Ждать УдалитьФайлыАсинх(ПутьКонсоли);
		Исключение
		КонецПопытки;
	КонецПопытки;

	Форма.конс_HTML = "";

	Возврат Неопределено;

КонецФункции

Асинх Функция ИзвлечьИсходникиКонсолиАсинх(Форма, КаталогИсходников)

	// Не очищаем весь каталог: он может использоваться другой формой или ещё подгружающимся HTML.
	// Перед записью макета удаляем только предыдущий zip (если был).
	ИмяФайлаZip = КаталогИсходников + "bsl_console.zip";
	ФайлZip = Новый Файл(ИмяФайлаZip);
	Если Ждать ФайлZip.СуществуетАсинх() Тогда
		Ждать УдалитьФайлыАсинх(ИмяФайлаZip);
	КонецЕсли;
	
	ДанныеМакета = ПолучитьИзВременногоХранилища(Форма.конс_АдресМакета);
	Ждать ДанныеМакета.ЗаписатьАсинх(ИмяФайлаZip);
	
	#Если Не ВебКлиент Тогда
	Попытка
		Файл = Новый ЧтениеZipФайла(ИмяФайлаZip);
		Файл.ИзвлечьВсе(КаталогИсходников);

		КаталогКорняBundle = Ждать КаталогКорняBundleКонсолиАсинх(КаталогИсходников);
		Если Не ЗначениеЗаполнено(КаталогКорняBundle) Тогда
			ТекстОшибки = "В архиве консоли не найден index.html в ожидаемых расположениях:"
				+ Символы.ПС + "  • <каталог сессии>\index.html"
				+ Символы.ПС + "  • <каталог сессии>\Monaco\index.html"
				+ Символы.ПС + "  • <каталог сессии>\src\index.html"
				+ Символы.ПС + "Пересоберите ZIP: в корне архива должны лежать index.html, vs\, скрипты (см. Monaco\BUILD.md).";
			Ждать ВывестиОшибкуАсинх(ТекстОшибки, Истина, Форма);
		Иначе
			Ждать СкопироватьИндексныйФайлВоВременныйАсинх(КаталогКорняBundle, Форма);
		КонецЕсли;
	Исключение
		Ждать ВывестиОшибкуАсинх("Не удалось извлечь исходники" + Символы.ПС + ОписаниеОшибки(), Истина, Форма);
	КонецПопытки;
	#КонецЕсли

	Возврат Неопределено;

КонецФункции

Процедура ИнициализацияРедактора(Форма)

	Инфо = Новый СистемнаяИнформация;

	Попытка
		конс_КомандыРедактораКлиент.View(Форма).dismissLoadingIndicator();
	Исключение
	КонецПопытки;

	Попытка
		конс_КомандыРедактораКлиент.View(Форма).init(Инфо.ВерсияПриложения);
		конс_КомандыРедактораКлиент.View(Форма).setOption("autoResizeEditorLayout", Истина);
		конс_КомандыРедактораКлиент.View(Форма).setOption("renderQueryDelimiters", Истина);
		конс_КомандыРедактораКлиент.View(Форма).setOption("generateModificationEvent", Истина);
		конс_КомандыРедактораКлиент.View(Форма).hideScrollX();
		конс_КомандыРедактораКлиент.View(Форма).hideScrollY();
	Исключение
		// Monaco ещё грузится — init() отложен (initPending), повторим по EVENT_EDITOR_READY
	КонецПопытки;

КонецПроцедуры

// Возвращает каталог (с завершающим разделителем), в котором лежит index.html рядом с ресурсами bundle (vs/, *.js и т.д.).
// Учитывает типичную ошибку упаковки: в корне ZIP лежит каталог Monaco/ вместо файлов.
// Только асинхронная проверка существования файла — на клиенте синхронные методы Файл запрещены.
Асинх Функция КаталогКорняBundleКонсолиАсинх(Знач КаталогРаспаковки)

	КаталогНорм = НормализоватьПуть(КаталогРаспаковки);
	РазделительПути = ПолучитьРазделительПути();

	Кандидаты = Новый Массив;
	Кандидаты.Добавить(КаталогНорм);
	Кандидаты.Добавить(КаталогНорм + "Monaco" + РазделительПути);
	Кандидаты.Добавить(КаталогНорм + "src" + РазделительПути);

	Для Каждого КаталогКорня Из Кандидаты Цикл
		ФайлИндекса = Новый Файл(КаталогКорня + "index.html");
		Если Ждать ФайлИндекса.СуществуетАсинх() Тогда
			Возврат КаталогКорня;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

Функция НовыйИндексныйФайл(КаталогИсходников)

	Возврат КаталогИсходников + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0") + ".html";

КонецФункции

Функция НормализоватьПуть(Путь)

	Путь = СокрЛП(Путь);
	РазделительПути = ПолучитьРазделительПути();
	
	Если Прав(Путь, 1) <> РазделительПути Тогда
		Путь = Путь + РазделительПути;
	КонецЕсли;
	
	Возврат Путь;

КонецФункции

Асинх Функция ПодключитьКонсольКФормеАсинх(Форма)

	#Если ВебКлиент Тогда

	URLИзКонстанты = СокрЛП(Константы.конс_URLВебКонсоли.Получить());
	Если ЗначениеЗаполнено(URLИзКонстанты) Тогда
		Форма.конс_HTML = URLИзКонстанты;
	Иначе
		Форма.конс_HTML = "https://salexdv.github.io/bsl_console/src/index.html";
	КонецЕсли;
	Форма.конс_ИсходникиЗагружены = Истина;
	Возврат Неопределено;

	#КонецЕсли

	ИмяКаталога = Ждать КаталогВременныхФайловАсинх();
	РазделительПути = ПолучитьРазделительПути();
	ИдентификаторСессии = СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "");
	КаталогИсходников = ИмяКаталога + "bsl_console" + РазделительПути + ИдентификаторСессии + РазделительПути;
	
	Ждать СоздатьКаталогАсинх(КаталогИсходников);
	
	ФайлКаталога = Новый Файл(КаталогИсходников);
	Существует = Ждать ФайлКаталога.СуществуетАсинх();
	
	Если Не Существует Тогда
		Ждать ВывестиОшибкуАсинх("Не удалось создать каталог для исходников", Истина, Форма);
		Возврат Неопределено;
	КонецЕсли;
	
	// Всегда распаковываем макет заново — иначе в каталоге могут остаться устаревшие файлы.
	Ждать ИзвлечьИсходникиКонсолиАсинх(Форма, КаталогИсходников);

	КаталогКорня = Ждать КаталогКорняBundleКонсолиАсинх(КаталогИсходников);
	Если Не ЗначениеЗаполнено(КаталогКорня) Тогда
		Ждать ВывестиОшибкуАсинх("После распаковки не найден index.html. Пересоберите макет конс_src.", Истина, Форма);
		Возврат Неопределено;
	КонецЕсли;

	ФайлLoader = Новый Файл(КаталогКорня + "vs" + РазделительПути + "loader.js");
	Если Не Ждать ФайлLoader.СуществуетАсинх() Тогда
		Ждать ВывестиОшибкуАсинх("В макете конс_src отсутствует vs/loader.js. Обновите расширение из EDT.", Истина, Форма);
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

Функция ПолучитьКаталогИсходногоКода()

	КаталогИсходногоКода = конс_ИнициализацияРедактораВызовСервера.КаталогИсходногоКодаКонфигурации();
	
	Если ЗначениеЗаполнено(КаталогИсходногоКода) Тогда
		КаталогИсходногоКода = НормализоватьПуть(КаталогИсходногоКода);
	КонецЕсли;
	
	Возврат КаталогИсходногоКода;

КонецФункции

Асинх Функция СкопироватьИндексныйФайлВоВременныйАсинх(Знач КаталогИсходников, Знач Форма)

	ТочкаВхода = КаталогИсходников + "index.html";
	ПутьВременногоHtml = НовыйИндексныйФайл(КаталогИсходников);
	Ждать КопироватьФайлАсинх(ТочкаВхода, ПутьВременногоHtml);
	Форма.конс_ИсходникиЗагружены = Истина;
	// Путь задаём последним: иначе поле HTML начнёт загрузку до появления файла.
	Форма.конс_HTML = ПутьВременногоHtml;

	Возврат Неопределено;

КонецФункции

Процедура УстановитьКартинкуСтраницы(Форма, Знач Страница, Знач КодЗаполнен)

	Если КодЗаполнен Тогда
		Форма.Элементы[Страница].Картинка = Форма.конс_КартинкаКода;
	Иначе
		Форма.Элементы[Страница].Картинка = Новый Картинка;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

