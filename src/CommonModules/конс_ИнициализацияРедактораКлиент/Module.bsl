#Область ПрограммныйИнтерфейс

// Инициализирует редактор и включает дополнительные функции консоли. Вызывается из обработчика
// формы конс_ПодключаемыйДокументСформирован, когда поле HTML сформировало документ консоли.
//
// Параметры:
//  Элемент - ПолеФормы                  - поле HTML конс_Код (в теле не используется)
//  Форма   - ФормаКлиентскогоПриложения - форма, в которой сформирован документ
//
Процедура ДокументСформирован(Элемент, Форма) Экспорт

	ИнициализацияРедактора(Форма);
	АктивироватьДополнительныеФункции(Форма);

КонецПроцедуры

// Обрабатывает событие получения метаданных для редактора кода, загружает структуру модулей или объектов по запросу и управляет подсказками
// 
// Параметры:
//  Форма   - ФормаКлиентскогоПриложения - Форма, в которой размещен редактор кода
//  Событие - Структура                  - Содержит параметры запроса: trigger (тип события), metadata (метаданные для загрузки), snippet_guid (идентификатор сниппета)
Процедура ОбработкаСобытияПолученияМетаданных(Форма, Событие) Экспорт

	ПараметрыЗапроса = НРег(Событие.metadata);
	ДанныеОбновлены = Ложь;
	
	Если 0 < СтрНайти(ПараметрыЗапроса, ".") Тогда
	
		ЧастиЗапроса = СтрРазделить(ПараметрыЗапроса, ".");
	
		Если ЧастиЗапроса[0] = "module" Тогда
	
			Если ЧастиЗапроса.Количество() = 2 Тогда
				ДанныеОбновлены = ЗагрузитьСтруктуруОбщегоМодуляПоЗапросу(Форма, ЧастиЗапроса);
			Иначе
				ДанныеОбновлены = ЗагрузитьСтруктуруМодуляМенеджераИлиОбъектаПоЗапросу(Форма, ЧастиЗапроса);
			КонецЕсли;
	
		Иначе
	
			ДанныеОбновлены = ЗагрузитьОбъектМетаданныхПоЗапросу(Форма, ПараметрыЗапроса);
	
		КонецЕсли;
	
	Иначе
	
		ДанныеОбновлены = ЗагрузитьСписокМетаданныхПоЗапросу(Форма, ПараметрыЗапроса);
	
	КонецЕсли;
	
	Если Событие.trigger = "suggestion" И ДанныеОбновлены Тогда
		конс_КомандыРедактораКлиент.View(Форма).triggerSuggestions();
	КонецЕсли;
	
	Если Событие.trigger = "snippet" Тогда
		конс_КомандыРедактораКлиент.View(Форма).updateSnippetByGUID(Событие.snippet_guid);
	КонецЕсли;

КонецПроцедуры

// Выполняет действия перед записью данных формы, сохраняет текущий программный код с активной страницы редактора в соответствии с ее ключом
// 
// Параметры:
//  Форма           - ФормаКлиентскогоПриложения - Объект формы, с которой работает метод
//  Отказ           - Булево                     - Определяет, следует ли отменить запись данных формы
//  ПараметрыЗаписи - Неопределено               - Параметры выполняемой записи, специфичные для конкретного действия
Процедура ПередЗаписью(Форма, Отказ, ПараметрыЗаписи) Экспорт

	// последняя используемая страница с кодом
	ТекущаяСтраница = Форма.конс_КлючАктивнойСтраницы;
	
	// получаем текущий код
	ТекущийКод = конс_КомандыРедактораКлиент.ПолучитьТекст(Форма);
	
	Соответствие = Неопределено;
	// сохраняем текущий код по ключу страницы
	ЕстьКодНаТекущейСтранице = Форма.конс_СоответствияКодовНаСтранице.Свойство(ТекущаяСтраница, Соответствие);
	Если ЕстьКодНаТекущейСтранице Тогда
		Соответствие.Вставить("Код", ТекущийКод);
	КонецЕсли;

КонецПроцедуры

// Извлекает имя модуля из пути файла и читает его текстовое содержимое
// 
// Параметры:
//  ПолноеИмяФайла - Строка - Полный путь к файлу модуля на диске
// 
// Возвращаемое значение:
// Структура:
// * Имя - Строка - имя модуля
// * Текст - Строка - текст модуля
Функция ПолучитьМодульИзИсходников(ПолноеИмяФайла) Экспорт
	
	#Если Не ВебКлиент Тогда
	
	СмещениеИмениВПути = 2;
	
	Путь = СтрРазделить(ПолноеИмяФайла, ПолучитьРазделительПути(), Ложь);
	ИмяМодуля = Путь[Путь.Количество() - СмещениеИмениВПути];
	
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ПолноеИмяФайла, "UTF-8");
	ТекстМодуля = Текст.ПолучитьТекст();
	
	Возврат Новый Структура("Имя, Текст", ИмяМодуля, ТекстМодуля);
	
	#Иначе
	
	Возврат Новый Структура("Имя, Текст", "", "");
	
	#КонецЕсли
	
КонецФункции

// Переход к определению (событие EVENT_GET_DEFINITION): открывает модуль из каталога исходников
// в форме просмотра с позиционированием на функции либо ищет определение в текущем редакторе.
//
// Параметры:
//  Форма             - ФормаКлиентскогоПриложения - форма с редактором
//  ПараметрыСобытия  - Структура - параметры события (word, expression, module, class, line, column)
Процедура ОткрытьОпределение(Форма, ПараметрыСобытия) Экспорт

	#Если Не ВебКлиент Тогда

	ИмяМодуля = ПараметрыСобытия.module;

	Если ЗначениеЗаполнено(ИмяМодуля) Тогда

		КаталогИсходногоКода = ПолучитьКаталогИсходногоКода();

		Если ЗначениеЗаполнено(КаталогИсходногоКода) Тогда

			ИмяВКонфигураторе = Форма.конс_ИменаОбщихМодулей.Получить(НРег(ИмяМодуля));
			Если ИмяВКонфигураторе = Неопределено Тогда
				ИмяВКонфигураторе = ИмяМодуля;
			КонецЕсли;

			ФайлМодуля = СтрШаблон("%1CommonModules%2%3%2Module.bsl", КаталогИсходногоКода,
				ПолучитьРазделительПути(), ИмяВКонфигураторе);

			ФайлНаДиске = Новый Файл(ФайлМодуля);

			Если ФайлНаДиске.Существует() Тогда
				Модуль = ПолучитьМодульИзИсходников(ФайлНаДиске.ПолноеИмя);
				ОткрытьМодульНаПросмотр(Форма, Модуль.Имя, Модуль.Текст, ПараметрыСобытия.word);
				Возврат;
			КонецЕсли;

		КонецЕсли;

		Возврат;

	КонецЕсли;

	// Модуль не указан - ищем определение в текущем редакторе
	конс_КомандыРедактораКлиент.View(Форма).goToFuncDefinition(ПараметрыСобытия.word);

	#КонецЕсли

КонецПроцедуры

// Обрабатывает переключение между вкладками редактора кода: сохраняет текущий код при уходе со вкладки, восстанавливает или очищает код при активации новой вкладки
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Экземпляр формы, содержащей редактор кода и связанные элементы управления
// 
// Возвращаемое значение:
// Булево - Признак наличия кода на активированной вкладке
Функция ПриИзмененииВкладкиСКодом(Форма) Экспорт

	АктивированнаяВкладка = Форма.конс_КлючАктивированнойСтраницы;
	
	// проверяем есть ли консоль на текущей странице
	ТекСтраница = Форма.конс_КлючАктивнойСтраницы;
	
	ЕстьКодНаТекущейСтранице = Форма.конс_СоответствияКодовНаСтранице.Свойство(ТекСтраница);
	Если ЕстьКодНаТекущейСтранице Тогда
		
		// получаем текущий код
		ТекущийКод = конс_КомандыРедактораКлиент.ПолучитьТекст(Форма);
		КодЗаполнен = ЗначениеЗаполнено(ТекущийКод);
		
		// сохраняем текущий код по ключу страницы
		Соответствие = Форма.конс_СоответствияКодовНаСтранице[ТекСтраница];
		Соответствие.Вставить("Код", ТекущийКод);
		Соответствие.Вставить("КодЗаполнен", КодЗаполнен);
	КонецЕсли;
	
	// очищаем код страницы
	конс_КомандыРедактораКлиент.ОчиститьТекст(Форма, Истина);
	
	// проверяем есть ли консоль на следующей странице
	ЕстьКодНаСтранице = Форма.конс_СоответствияКодовНаСтранице.Свойство(АктивированнаяВкладка);
	
	Если ЕстьКодНаСтранице Тогда
		
		// устанавливаем код текущей страницы
		Соответствие = Форма.конс_СоответствияКодовНаСтранице[АктивированнаяВкладка];
		ПрограммныйКод = Соответствие.Код;
	
		конс_КомандыРедактораКлиент.ОбновитьТекст(Форма, ПрограммныйКод, Истина, Истина);
	КонецЕсли;
	
	// помещаем ключ текущей страницы в реквизит активной страницы
	Форма.конс_КлючАктивнойСтраницы = АктивированнаяВкладка;
	
	Возврат ЕстьКодНаСтранице;

КонецФункции

// Показывает консоль в поле HTML: присваивает реквизиту конс_HTML текст консоли, подготовленный
// при создании формы (см. конс_ИнициализацияРедактораСервер.ПриСозданииНаСервере), и освобождает
// временное хранилище. Справочник синтаксиса и список общих модулей передаются в консоль позже,
// по событию EVENT_EDITOR_READY.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, с которой интегрируется консоль
//
Процедура ПриОткрытии(Форма) Экспорт

	Форма.конс_HTML = ПолучитьИзВременногоХранилища(Форма.конс_АдресКодКонсоли);
	ПоместитьВоВременноеХранилище(Неопределено, Форма.конс_АдресКодКонсоли);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура АктивироватьДополнительныеФункции(Форма)

	Если Форма.Элементы.Найти("конс_ТолькоДляЧтения") <> Неопределено Тогда
	
		Форма.Элементы.конс_КонструкторЗапроса.Доступность = Истина;
		Форма.Элементы.конс_ТолькоДляЧтения.Доступность = Истина;
		Форма.Элементы.конс_БыстрыеПодсказки.Доступность = Истина;
		Форма.Элементы.конс_ПодсвечиватьЗапросы.Доступность = Истина;
		Форма.Элементы.конс_СтрокаСостояния.Доступность = Истина;
	
		конс_КомандыРедактораКлиент.УправлениеБыстрымиПодсказками(Форма);
		конс_КомандыРедактораКлиент.УправлениеВидимостьюСтрокиСостояния(Форма);

	КонецЕсли;

	АктивироватьВыполнениеКода(Форма);

	// Генерация события EVENT_GET_DEFINITION при переходе к определению (Ctrl+клик, F12)
	конс_КомандыРедактораКлиент.View(Форма).setOption("generateDefinitionEvent", Истина);

	ПрименитьСохраненныеНастройки(Форма);

КонецПроцедуры

// Восстанавливает пользовательские настройки редактора из хранилища системных настроек
Процедура ПрименитьСохраненныеНастройки(Форма)

	Настройки = конс_ИнициализацияРедактораВызовСервера.НастройкиРедактора();

	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;

	Значение = Неопределено;

	Если Настройки.Свойство("Тема", Значение) И ЗначениеЗаполнено(Значение) Тогда
		конс_КомандыРедактораКлиент.УстановитьТему(Форма, Значение, Ложь);
	КонецЕсли;

	Если Настройки.Свойство("НомераСтрок", Значение) Тогда
		Если Значение Тогда
			конс_КомандыРедактораКлиент.ПоказатьНомераСтрок(Форма, Ложь);
		Иначе
			конс_КомандыРедактораКлиент.СкрытьНомераСтрок(Форма, Ложь);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ОткрытьМодульНаПросмотр(Форма, ИмяМодуля, ТекстМодуля, ИмяФункции)

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", ИмяМодуля + " (только просмотр)");
	ПараметрыФормы.Вставить("Код", ТекстМодуля);
	ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
	ПараметрыФормы.Вставить("ИмяФункции", ИмяФункции);

	ОткрытьФорму("ОбщаяФорма.конс_РедактированиеКода", ПараметрыФормы, Форма);

КонецПроцедуры

// Включает команды выполнения кода и горячую клавишу Ctrl+Enter,
// если на форме есть кнопка конс_ВыполнитьКод и у пользователя есть право выполнения
Процедура АктивироватьВыполнениеКода(Форма)

	Если Форма.Элементы.Найти("конс_ВыполнитьКод") = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ВыполнениеДоступно = конс_КомандыРедактораКлиент.ВыполнениеКодаДоступно();

	Форма.Элементы.конс_ВыполнитьКод.Видимость = ВыполнениеДоступно;
	Если Форма.Элементы.Найти("конс_ВыполнитьЗапрос") <> Неопределено Тогда
		Форма.Элементы.конс_ВыполнитьЗапрос.Видимость = ВыполнениеДоступно;
	КонецЕсли;
	Если Форма.Элементы.Найти("конс_ПредыдущийКод") <> Неопределено Тогда
		Форма.Элементы.конс_ПредыдущийКод.Видимость = ВыполнениеДоступно;
	КонецЕсли;

	Если ВыполнениеДоступно Тогда
		// Ctrl+Enter = KeyMod.CtrlCmd (2048) | KeyCode.Enter (3)
		конс_КомандыРедактораКлиент.View(Форма).disableKeyBinding(2051);
	КонецЕсли;

КонецПроцедуры

Функция ЗагрузитьМодульМенеджераИлиОбъектаПоИмени(Форма, КаталогИсходногоКода, СтруктураВыгрузки)

	ЗагруженоФункций = 0;
	ТипМодуля = СтруктураВыгрузки.ТипМодуля;
	
	ИмяТипа = ?(ТипМодуля = "manager", "ManagerModule", "ObjectModule");
	
	ФайлМодуля = СтрШаблон("%1%2%3.bsl", СтруктураВыгрузки.ИмяКаталога, ПолучитьРазделительПути(), ИмяТипа);
	ФайлМодуля = КаталогИсходногоКода + ФайлМодуля;
	
	ФайлНаДиске = Новый Файл(ФайлМодуля);
	
	Если ФайлНаДиске.Существует() Тогда
		Модуль = ПолучитьМодульИзИсходников(ФайлНаДиске.ПолноеИмя);
		ИмяКоллекции = конс_ИнициализацияРедактораВызовСервера.ПолучитьИмяКоллекцииМетаданныхПоТипу(
			СтруктураВыгрузки.ТипМетаданных);
		АдресЗагрузки = СтрШаблон("%1.items.%2.%3", ИмяКоллекции, СтруктураВыгрузки.ИмяОбъектаМетаданных, ТипМодуля);
		ЗагруженоФункций = конс_КомандыРедактораКлиент.View(Форма).parseMetadataModule(Модуль.Текст, АдресЗагрузки);
	КонецЕсли;
	
	Возврат ЗагруженоФункций;

КонецФункции

Функция ЗагрузитьОбщийМодульПоИмени(Форма, КаталогИсходногоКода, ИмяМодуля, Глобальный)

	ЗагруженоФункций = 0;
	
	ИмяВКонфигураторе = Форма.конс_ИменаОбщихМодулей.Получить(НРег(ИмяМодуля));
	
	Если ИмяВКонфигураторе = Неопределено Тогда
		ИмяВКонфигураторе = ИмяМодуля;
	КонецЕсли;
	
	ФайлМодуля = СтрШаблон("CommonModules%1%2%1Module.bsl", ПолучитьРазделительПути(), ИмяВКонфигураторе);
	ФайлМодуля = КаталогИсходногоКода + ФайлМодуля;
	
	ФайлНаДиске = Новый Файл(ФайлМодуля);
	
	Если ФайлНаДиске.Существует() Тогда
		ОбщийМодуль = ПолучитьМодульИзИсходников(ФайлНаДиске.ПолноеИмя);
		ЗагруженоФункций = конс_КомандыРедактораКлиент.View(Форма).parseCommonModule(ОбщийМодуль.Имя, ОбщийМодуль.Текст, Глобальный);
	КонецЕсли;
	
	Возврат ЗагруженоФункций;

КонецФункции

Функция ЗагрузитьОбъектМетаданныхПоЗапросу(Форма, ПараметрыЗапроса)

	АдресОбновления = "";
	ОписаниеМетаданных = конс_ИнициализацияРедактораВызовСервера.ПолучитьОписаниеОбъектаМетаданных(ПараметрыЗапроса,
		АдресОбновления);
	
	Если ЗначениеЗаполнено(ОписаниеМетаданных) Тогда
	
		Если ТипЗнч(конс_КомандыРедактораКлиент.View(Форма).updateMetadata(ОписаниеМетаданных, АдресОбновления)) = Тип("Булево") Тогда
			Возврат Истина;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция ЗагрузитьСписокМетаданныхПоЗапросу(Форма, ПараметрыЗапроса)

	АдресОбновления = "";
	ОписаниеМетаданных = конс_ИнициализацияРедактораВызовСервера.ПолучитьСписокОбъектовМетаданных(ПараметрыЗапроса,
		АдресОбновления);
	
	Если ЗначениеЗаполнено(ОписаниеМетаданных) Тогда
	
		Если ТипЗнч(конс_КомандыРедактораКлиент.View(Форма).updateMetadata(ОписаниеМетаданных, АдресОбновления)) = Тип("Булево") Тогда
			Возврат Истина;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция ЗагрузитьСтруктуруМодуляМенеджераИлиОбъектаПоЗапросу(Форма, ЧастиЗапроса)

	КаталогИсходногоКода = ПолучитьКаталогИсходногоКода();
	КоличествоЧастейЗапроса = 4;
	
	Если ЗначениеЗаполнено(КаталогИсходногоКода) И ЧастиЗапроса.Количество() = КоличествоЧастейЗапроса Тогда
	
		СтруктураВыгрузки = Новый Структура;
		СтруктураВыгрузки.Вставить("ТипМодуля", ЧастиЗапроса[1]);
		СтруктураВыгрузки.Вставить("ТипМетаданных", ЧастиЗапроса[2]);
		СтруктураВыгрузки.Вставить("ОбъектМетаданных", ЧастиЗапроса[3]);
	
		конс_ИнициализацияРедактораВызовСервера.ДополнитьСтруктуруВыгрузкиИсходниковМетаданных(СтруктураВыгрузки,
			ПолучитьРазделительПути());
	
		Если ЗначениеЗаполнено(СтруктураВыгрузки.ИмяКаталога) Тогда
	
			ЗагруженоФункций = ЗагрузитьМодульМенеджераИлиОбъектаПоИмени(Форма, КаталогИсходногоКода, СтруктураВыгрузки);
	
			Если 0 < ЗагруженоФункций Тогда
				Возврат Истина;
			КонецЕсли;
	
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция ЗагрузитьСтруктуруОбщегоМодуляПоЗапросу(Форма, ЧастиЗапроса)

	КаталогИсходногоКода = ПолучитьКаталогИсходногоКода();
	КоличествоЧастейЗапроса = 2;
	
	Если ЗначениеЗаполнено(КаталогИсходногоКода) И ЧастиЗапроса.Количество() = КоличествоЧастейЗапроса Тогда
	
		ИмяМодуля = ЧастиЗапроса[1];
	
		ЗагруженоФункций = ЗагрузитьОбщийМодульПоИмени(Форма, КаталогИсходногоКода, ИмяМодуля, Ложь);
	
		Если 0 < ЗагруженоФункций Тогда
			Возврат Истина;
		КонецЕсли;
	
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Процедура ИнициализацияРедактора(Форма)

	Инфо = Новый СистемнаяИнформация;

	конс_КомандыРедактораКлиент.View(Форма).init(Инфо.ВерсияПриложения);
	конс_КомандыРедактораКлиент.View(Форма).dismissLoadingIndicator();
	конс_КомандыРедактораКлиент.View(Форма).setOption("autoResizeEditorLayout", Истина);
	конс_КомандыРедактораКлиент.View(Форма).setOption("renderQueryDelimiters", Истина);
	конс_КомандыРедактораКлиент.View(Форма).setOption("generateModificationEvent", Истина);
	конс_КомандыРедактораКлиент.View(Форма).hideScrollX();
	конс_КомандыРедактораКлиент.View(Форма).hideScrollY();

КонецПроцедуры

Функция НормализоватьПуть(Путь)

	Путь = СокрЛП(Путь);
	РазделительПути = ПолучитьРазделительПути();
	
	Если Прав(Путь, 1) <> РазделительПути Тогда
		Путь = Путь + РазделительПути;
	КонецЕсли;
	
	Возврат Путь;

КонецФункции

Функция ПолучитьКаталогИсходногоКода()

	КаталогИсходногоКода = конс_ИнициализацияРедактораВызовСервера.КаталогИсходногоКодаКонфигурации();
	
	Если ЗначениеЗаполнено(КаталогИсходногоКода) Тогда
		КаталогИсходногоКода = НормализоватьПуть(КаталогИсходногоКода);
	КонецЕсли;
	
	Возврат КаталогИсходногоКода;

КонецФункции

#КонецОбласти

