#Область ПрограммныйИнтерфейс

// Создает служебные реквизиты консоли на форме, помещает во временное хранилище текст консоли
// и справочник синтаксиса платформы. Сама консоль показывается в поле HTML при открытии формы
// (см. конс_ИнициализацияРедактораКлиент.ПриОткрытии).
//
// Параметры:
//  Форма                 - ФормаКлиентскогоПриложения - форма, с которой будет интегрироваться консоль;
//                          на форме должно быть поле HTML конс_Код с реквизитом конс_HTML
//  СоздатьБазовыеКоманды - Булево - создать команды и кнопки по умолчанию (конструктор запроса,
//                          только для чтения, быстрые подсказки, подсветка запросов, строка состояния)
//                          в группе конс_ГруппаКомандКонсоли; обработчик команд на форме -
//                          конс_ПодключаемыйБазовыеКоманды
//
Процедура ПриСозданииНаСервере(Форма, СоздатьБазовыеКоманды = Ложь) Экспорт

	Элементы = Форма.Элементы;

	//@skip-check module-attachable-event-handler-name
	Элементы.конс_Код.УстановитьДействие("ДокументСформирован", "конс_ПодключаемыйДокументСформирован");
	//@skip-check module-attachable-event-handler-name
	Элементы.конс_Код.УстановитьДействие("ПриНажатии", "конс_ПодключаемыйПриНажатии");

	ДобавляемыеРеквизиты = Новый Массив;

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_ТолькоДляЧтения", Новый ОписаниеТипов("Булево"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_БыстрыеПодсказки", Новый ОписаниеТипов("Булево"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_ПодсвечиватьЗапросы", Новый ОписаниеТипов("Булево"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_ВидимостьСтрокиСостояния", Новый ОписаниеТипов("Булево"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_ЭтоИзменениеСтраницы", Новый ОписаниеТипов("Булево"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_КлючАктивнойСтраницы", Новый ОписаниеТипов("Строка"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_КлючАктивированнойСтраницы", Новый ОписаниеТипов("Строка"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_АдресКодКонсоли", Новый ОписаниеТипов("Строка"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_АдресСинтаксисПлатформы", Новый ОписаниеТипов("Строка"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_АдресОбщихМодулей", Новый ОписаниеТипов("Строка"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_СоответствияКодовНаСтранице", Новый ОписаниеТипов);
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_ИменаОбщихМодулей", Новый ОписаниеТипов);
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_ГлобальныйМодули", Новый ОписаниеТипов);
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_КартинкаКода", Новый ОписаниеТипов("Картинка"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_РежимПросмотра", Новый ОписаниеТипов("Булево"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	ДобавляемыйРеквизит	= Новый РеквизитФормы("конс_ИмяФункцииПерехода", Новый ОписаниеТипов("Строка"));
	ДобавляемыеРеквизиты.Добавить(ДобавляемыйРеквизит);

	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	ЗаполнитьНачальныеЗначенияРеквизитов(Форма);

	Если СоздатьБазовыеКоманды Тогда
		СоздатьКомандыКнопки(Форма);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Помещает текст консоли и справочник синтаксиса во временное хранилище формы (клиент забирает их
// и очищает хранилище после показа консоли) и заполняет начальные значения служебных реквизитов.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью
//
Процедура ЗаполнитьНачальныеЗначенияРеквизитов(Знач Форма)

	Форма.конс_АдресКодКонсоли = ПоместитьВоВременноеХранилище(
		ПолучитьОбщийМакет("конс_КонсольКода").ПолучитьТекст(), Форма.УникальныйИдентификатор);

	Форма.конс_АдресСинтаксисПлатформы = ПоместитьВоВременноеХранилище(
		ПолучитьОбщийМакет("конс_СинтаксисКонсоли").ПолучитьТекст(), Форма.УникальныйИдентификатор);

	КоллекцияОбщихМодулей			= ПолучитьКоллекциюОбщихМодулей();
	Форма.конс_АдресОбщихМодулей	= СохранитьОбщиеМодулиВХранилище(КоллекцияОбщихМодулей);

	ЗаполнитьИменаОбщихМодулей(Форма, КоллекцияОбщихМодулей);

	Форма.конс_БыстрыеПодсказки			= Истина;
	Форма.конс_ПодсвечиватьЗапросы		= Истина;
	Форма.конс_ВидимостьСтрокиСостояния	= Истина;
	Форма.конс_КартинкаКода				= БиблиотекаКартинок.СинтаксическийКонтроль;

КонецПроцедуры

// Создает базовые команды консоли и кнопки для них.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью
//
Процедура СоздатьКомандыКнопки(Знач Форма)

	СоздатьКомандыФормы(Форма);
	СоздатьКнопкиФормы(Форма);

КонецПроцедуры

// Добавляет на форму базовые команды консоли, если их еще нет. Все команды обрабатывает
// процедура формы конс_ПодключаемыйБазовыеКоманды.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью
//
Процедура СоздатьКомандыФормы(Знач Форма)

	СоздатьКоманду(Форма,
		"конс_БыстрыеПодсказки",
		"Включить/выключить быстрые подсказки",
		"конс_ПодключаемыйБазовыеКоманды",
		БиблиотекаКартинок.ТабличныйДокументОтображатьПримечания,
		ОтображениеКнопки.Картинка);

	СоздатьКоманду(Форма,
		"конс_КонструкторЗапроса",
		"Конструктор запроса",
		"конс_ПодключаемыйБазовыеКоманды",
		БиблиотекаКартинок.КонструкторЗапроса,
		ОтображениеКнопки.КартинкаИТекст);

	СоздатьКоманду(Форма,
		"конс_ПодсвечиватьЗапросы",
		"Включить/выключить подсветку синтаксиса языка запросов",
		"конс_ПодключаемыйБазовыеКоманды",
		БиблиотекаКартинок.УсловноеОформлениеКомпоновкиДанных,
		ОтображениеКнопки.Картинка);

	СоздатьКоманду(Форма,
		"конс_СтрокаСостояния",
		"Включить/выключить отображение строки состояния",
		"конс_ПодключаемыйБазовыеКоманды",
		БиблиотекаКартинок.ПереключитьАктивность,
		ОтображениеКнопки.Картинка);

	СоздатьКоманду(Форма,
		"конс_ТолькоДляЧтения",
		"Включить/выключить режим редактирования",
		"конс_ПодключаемыйБазовыеКоманды",
		БиблиотекаКартинок.ТабличныйДокументТолькоПросмотр,
		ОтображениеКнопки.Картинка);

КонецПроцедуры

// Вставляет кнопки базовых команд в начало группы конс_ГруппаКомандКонсоли
// (если группы на форме нет - в командную панель формы). Кнопки, уже размещенные на форме, не дублируются.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма с консолью
//
Процедура СоздатьКнопкиФормы(Знач Форма)

	Элементы = Форма.Элементы;
	ГруппаРодитель = Элементы.Найти("конс_ГруппаКомандКонсоли");
	ВставитьПеред = Неопределено;

	Если ГруппаРодитель = Неопределено Тогда
		ГруппаРодитель = Форма.КоманднаяПанель;
	ИначеЕсли ЗначениеЗаполнено(ГруппаРодитель.ПодчиненныеЭлементы) Тогда
		ВставитьПеред = ГруппаРодитель.ПодчиненныеЭлементы[0];
	КонецЕсли;

	СоздатьКнопкуФормы(Элементы, "конс_КонструкторЗапроса", ГруппаРодитель, ВставитьПеред);
	СоздатьКнопкуФормы(Элементы, "конс_ТолькоДляЧтения", ГруппаРодитель, ВставитьПеред);
	СоздатьКнопкуФормы(Элементы, "конс_БыстрыеПодсказки", ГруппаРодитель, ВставитьПеред);
	СоздатьКнопкуФормы(Элементы, "конс_ПодсвечиватьЗапросы", ГруппаРодитель, ВставитьПеред);
	СоздатьКнопкуФормы(Элементы, "конс_СтрокаСостояния", ГруппаРодитель, ВставитьПеред);

КонецПроцедуры

// Добавляет кнопку командной панели для одноименной команды формы, если кнопки с таким именем еще нет.
//
// Параметры:
//  Элементы               - ВсеЭлементыФормы - элементы формы
//  ИмяКоманды             - Строка - имя команды формы, оно же имя кнопки
//  Родитель               - ГруппаФормы, КоманднаяПанельФормы - куда вставить кнопку
//  ВставитьПередЭлементом - ЭлементФормы, Неопределено - перед каким элементом вставить кнопку
//
Процедура СоздатьКнопкуФормы(Элементы, ИмяКоманды, Родитель, ВставитьПередЭлементом = Неопределено)

	Если Элементы.Найти(ИмяКоманды) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Кнопка = Элементы.Вставить(ИмяКоманды, Тип("КнопкаФормы"), Родитель, ВставитьПередЭлементом);
	Кнопка.Вид			= ВидКнопкиФормы.КнопкаКоманднойПанели;
	Кнопка.ИмяКоманды	= ИмяКоманды;

КонецПроцедуры

// Добавляет команду формы, если команды с таким именем еще нет.
//
// Параметры:
//  Форма       - ФормаКлиентскогоПриложения - форма с консолью
//  ИмяКоманды  - Строка - имя команды
//  Заголовок   - Строка - заголовок и подсказка команды
//  Действие    - Строка - имя клиентской процедуры формы - обработчика команды
//  Картинка    - Картинка - картинка команды
//  Отображение - ОтображениеКнопки - вариант отображения кнопок команды
//
Процедура СоздатьКоманду(Форма, ИмяКоманды, Заголовок, Действие, Картинка, Отображение)

	Если Форма.Команды.Найти(ИмяКоманды) <> Неопределено Тогда
		Возврат;
	КонецЕсли;

	Команда = Форма.Команды.Добавить(ИмяКоманды);
	Команда.Заголовок	= Заголовок;
	Команда.Подсказка	= Заголовок;
	Команда.Картинка	= Картинка;
	Команда.Отображение	= Отображение;
	Команда.Действие	= Действие;

КонецПроцедуры

Функция ПолучитьКоллекциюОбщихМодулей()

	КоллекцияОбщихМодулей = Новый Структура;
	КоллекцияОбщихМодулей.Вставить("Общие", ОписатьОбщиеМодули(Метаданные.ОбщиеМодули, Ложь));
	КоллекцияОбщихМодулей.Вставить("Глобальные", ОписатьОбщиеМодули(Метаданные.ОбщиеМодули, Истина));

	Возврат КоллекцияОбщихМодулей;

КонецФункции

Функция ОписатьОбщиеМодули(Коллекция, ФильтрГлобальный = Ложь)

	ОписаниеКоллекции = Новый Структура;

	Для НомерОбъекта = 0 По Коллекция.Количество() - 1 Цикл
		ОбъектМетаданных = Коллекция.Получить(НомерОбъекта);
		Если ОбъектМетаданных.Глобальный = ФильтрГлобальный Тогда
			ОписаниеКоллекции.Вставить(ОбъектМетаданных.Имя, Новый Структура);
		КонецЕсли;
	КонецЦикла;

	Возврат ОписаниеКоллекции;

КонецФункции

Функция СохранитьОбщиеМодулиВХранилище(КоллекцияОбщихМодулей)

	Файл = Новый ЗаписьJSON;
	Файл.УстановитьСтроку();
	Попытка
		ЗаписатьJSON(Файл, КоллекцияОбщихМодулей.Общие);
	Исключение
		ВызватьИсключение ("Не удалось сохранить коллекцию метаданных:" + Символы.ПС + ОписаниеОшибки());
	КонецПопытки;

	ЗначениеКоллекции = Файл.Закрыть();

	Возврат ПоместитьВоВременноеХранилище(ЗначениеКоллекции, Новый УникальныйИдентификатор);

КонецФункции

Процедура ЗаполнитьИменаОбщихМодулей(Форма, КоллекцияОбщихМодулей)
	
	// Соответствие между именем общего неглобального модуля в нижнем регистре
	// и именем модуля, как оно задано в конфигураторе для правильной загрузки
	// текстов общих модулей
	ОбщиеМодули = Новый Соответствие;

	Для Каждого Обход Из КоллекцияОбщихМодулей.Общие Цикл
		ОбщиеМодули.Вставить(НРег(Обход.Ключ), Обход.Ключ);
	КонецЦикла;

	Форма.конс_ИменаОбщихМодулей = Новый ФиксированноеСоответствие(ОбщиеМодули);
	
	// Именя глобальных модулей для загрузки текстов
	Модули = Новый Массив;

	Для Каждого Обход Из КоллекцияОбщихМодулей.Глобальные Цикл
		Модули.Добавить(Обход.Ключ);
	КонецЦикла;

	Форма.конс_ГлобальныйМодули = Новый ФиксированныйМассив(Модули);

КонецПроцедуры

#КонецОбласти